@model Museum.Models.NewFolder.AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
    ViewBag.HasHeroTitle = true;
}

<div class="analytics-page">
    <!-- Hero Section -->
    <div class="analytics-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="analytics-header" data-aos="fade-up">
                <div class="analytics-icon-wrapper">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h1 class="analytics-title">Museum Analytics</h1>
                <p class="analytics-subtitle">Overview of purchases and visits by date</p>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="analytics-content-section">
        <div class="container">
            <!-- Back Button -->
            <div class="back-button-wrapper" data-aos="fade-right">
                <a asp-controller="Dashboard" asp-action="Dashboard" class="btn-back-custom">
                    <i class="fas fa-arrow-left"></i>
                    Back to Dashboard
                </a>
            </div>

            <!-- Filter Card -->
            <div class="filter-card" data-aos="fade-up" data-aos-delay="100">
                <div class="filter-header">
                    <i class="fas fa-calendar-alt"></i>
                    <h3>Date Range Filter</h3>
                </div>

                <form method="get" class="filter-form">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label class="filter-label">
                                <i class="fas fa-calendar-day"></i> From Date
                            </label>
                            <input type="date" id="startDate" name="startDate" value="@ViewBag.StartDate" class="filter-input" />
                        </div>

                        <div class="filter-group">
                            <label class="filter-label">
                                <i class="fas fa-calendar-day"></i> To Date
                            </label>
                            <input type="date" id="endDate" name="endDate" value="@ViewBag.EndDate" class="filter-input" />
                        </div>

                        <div class="filter-group filter-actions-group">
                            <label class="filter-label">&nbsp;</label>
                            <button type="submit" class="btn-filter">
                                <i class="fas fa-filter"></i> Apply Filter
                            </button>
                        </div>

                        <div class="filter-group">
                            <label class="filter-label">&nbsp;</label>
                            <a class="btn-all-time" href="@Url.Action("Analytics", "Dashboard")">
                                <i class="fas fa-calendar"></i> All Time
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Date Range Info -->
            <div class="date-range-info" data-aos="fade-up" data-aos-delay="150">
                @if (ViewBag.IsAllTime == true)
                {
                    <div class="info-badge">
                        <i class="fas fa-infinity"></i>
                        <span>Showing Results: All Time</span>
                    </div>
                }
                else
                {
                    <div class="info-badge">
                        <i class="fas fa-calendar-week"></i>
                        <span>@DateTime.Parse(ViewBag.StartDate).ToString("dd MMM yyyy") - @DateTime.Parse(ViewBag.EndDate).ToString("dd MMM yyyy")</span>
                    </div>
                }
            </div>

            <!-- Stats Cards -->
            <div class="stats-row" data-aos="fade-up" data-aos-delay="200">
                <div class="stat-card-custom">
                    <div class="stat-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Total Orders</h3>
                        <p class="stat-value">@Model.TotalOrders</p>
                    </div>
                </div>
                <div class="stat-card-custom">
                    <div class="stat-icon">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Total Tickets Sold</h3>
                        <p class="stat-value">@Model.TotalTickets</p>
                    </div>
                </div>
            </div>

            <!-- Top Museums Section -->
            <div class="analytics-card" data-aos="fade-up" data-aos-delay="250">
                <div class="card-header-custom" data-bs-toggle="collapse" data-bs-target="#topMuseumsTable">
                    <div class="header-left">
                        <i class="fas fa-trophy"></i>
                        <h3>Top Museums by Tickets Sold</h3>
                    </div>
                    <i class="fas fa-chevron-down toggle-icon rotate"></i>
                </div>
                <div id="topMuseumsTable" class="collapse show">
                    <div class="card-body-custom">
                        <div class="table-responsive">
                            <table class="analytics-table">
                                <thead>
                                    <tr>
                                        <th>Museum</th>
                                        <th>Tickets Sold</th>
                                        <th>Orders</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model.TopMuseums)
                                    {
                                        <tr>
                                            <td class="museum-cell">
                                                <i class="fas fa-landmark"></i>
                                                @m.Museum.Name
                                            </td>
                                            <td class="tickets-cell">@m.TicketsSold</td>
                                            <td class="orders-cell">@m.OrdersCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- City Stats Section -->
            <div class="analytics-card" data-aos="fade-up" data-aos-delay="300">
                <div class="card-header-custom" data-bs-toggle="collapse" data-bs-target="#cityTable">
                    <div class="header-left">
                        <i class="fas fa-city"></i>
                        <h3>Purchases by City</h3>
                    </div>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </div>
                <div id="cityTable" class="collapse">
                    <div class="card-body-custom">
                        <div class="table-responsive">
                            <table class="analytics-table">
                                <thead>
                                    <tr>
                                        <th>City</th>
                                        <th>Tickets Sold</th>
                                        <th>Orders</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.CityStats)
                                    {
                                        <tr>
                                            <td class="city-cell">
                                                <i class="fas fa-location-dot"></i>
                                                @c.City
                                            </td>
                                            <td class="tickets-cell">@c.TicketsSold</td>
                                            <td class="orders-cell">@c.OrdersCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Country Stats Section -->
            <div class="analytics-card" data-aos="fade-up" data-aos-delay="350">
                <div class="card-header-custom" data-bs-toggle="collapse" data-bs-target="#countryTable">
                    <div class="header-left">
                        <i class="fas fa-globe-americas"></i>
                        <h3>Purchases by Country</h3>
                    </div>
                    <i class="fas fa-chevron-down toggle-icon"></i>
                </div>
                <div id="countryTable" class="collapse">
                    <div class="card-body-custom">
                        <div class="table-responsive">
                            <table class="analytics-table">
                                <thead>
                                    <tr>
                                        <th>Country</th>
                                        <th>Tickets Sold</th>
                                        <th>Orders</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.CountryStats)
                                    {
                                        <tr>
                                            <td class="country-cell">
                                                <i class="fas fa-flag"></i>
                                                @c.Country
                                            </td>
                                            <td class="tickets-cell">@c.TicketsSold</td>
                                            <td class="orders-cell">@c.OrdersCount</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Decorative Circles -->
    <ul class="circles">
        <li><i class="fa-solid fa-landmark"></i></li>
        <li><i class="fa-solid fa-building-columns"></i></li>
        <li><i class="fa-solid fa-monument"></i></li>
        <li><i class="fa-solid fa-gem"></i></li>
        <li><i class="fa-solid fa-scroll"></i></li>
        <li><i class="fa-solid fa-paint-roller"></i></li>
        <li><i class="fa-solid fa-palette"></i></li>
        <li><i class="fa-solid fa-book"></i></li>
        <li><i class="fa-solid fa-masks-theater"></i></li>
    </ul>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const startInput = document.getElementById("startDate");
            const endInput = document.getElementById("endDate");

            function updateLimits() {
                if (startInput.value) endInput.min = startInput.value;
                else endInput.min = "";

                if (endInput.value) startInput.max = endInput.value;
                else startInput.max = "";
            }

            updateLimits();
            if (startInput) startInput.addEventListener("change", updateLimits);
            if (endInput) endInput.addEventListener("change", updateLimits);

            // Toggle icon rotation for collapsible sections
            document.querySelectorAll('.card-header-custom').forEach(header => {
                header.addEventListener('click', function () {
                    const icon = this.querySelector('.toggle-icon');
                    setTimeout(() => {
                        icon.classList.toggle('rotate');
                    }, 100);
                });
            });
        });
    </script>
}
