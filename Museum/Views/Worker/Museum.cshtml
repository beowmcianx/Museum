@model Museum.Models.MuseumModel

@{
    ViewData["Title"] = $"{Model.Name}";
}

<!-- ===================== POPUP ALERT ===================== -->
@if (TempData["Success"] != null || TempData["Error"] != null)
{
    var isSuccess = TempData["Success"] != null;
    var message = isSuccess ? TempData["Success"] : TempData["Error"];

    <div id="ticketPopup"
         class="ticket-popup @(isSuccess ? "success" : "error")"
         data-aos="fade-left">

        <div class="popup-content">
            <span>@message</span>
            <button class="popup-close" onclick="closePopup()">×</button>
        </div>

    </div>
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1 class="display-4">@ViewData["Title"]</h1>
        <h5 class="text-secondary text-muted">View & manage your museum's information</h5>
    </div>

    <div class="row g-3 justify-content-center mb-5">

        <div class="col-md-4">
            <a class="btn btn-red page-dashboard-button w-100 text-center p-4 shadow-sm rounded-4"
               asp-area=""
               asp-controller="Worker"
               asp-action="EditMuseum"
               asp-route-id="@Model.MuseumId">
                <i class="fas fa-landmark fa-2x mb-2"></i><br />
                Museum Info
            </a>
        </div>

        <div class="col-md-4">
            <a class="btn btn-red page-dashboard-button w-100 text-center p-4 shadow-sm rounded-4"
               asp-area=""
               asp-controller="Worker"
               asp-action="EditMuseum"
               asp-route-id="@Model.MuseumId">
                <i class="fas fa-ticket fa-2x mb-2"></i><br />
                Order Info
            </a>
        </div>

    </div>

</div>

<!-- ===================== STYLIZED BACKGROUND CIRCLES ===================== -->
<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

@section Scripts {
    <script>
        function closePopup() {
            var popup = document.getElementById('ticketPopup');
            if (popup) popup.style.display = 'none';
        }

        // Optional: auto-hide after 3 seconds
        document.addEventListener('DOMContentLoaded', function () {
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                setTimeout(function () {
                    popup.style.display = 'none';
                }, 3000);
            }
        });
    </script>
