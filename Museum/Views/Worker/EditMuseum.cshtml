@model Museum.Models.MuseumModel

@{
    ViewData["Title"] = $"Edit {Model.Name}";
    var ticketTypes = Model.TicketTypes?.ToList() ?? new List<Museum.Models.TicketTypeModel>();
    ViewBag.HasHeroTitle = true;
}

<!-- Popup Alert -->
@if (TempData["Success"] != null || TempData["Error"] != null || TempData["Info"] != null)
{
    var isSuccess = TempData["Success"] != null;
    var isError = TempData["Error"] != null;
    var message =
        TempData["Success"] as string ??
        TempData["Error"] as string ??
        TempData["Info"] as string;

    <div id="ticketPopup" class="ticket-popup @(isSuccess ? "success" : isError ? "error" : "info")" data-aos="fade-left">
        <div class="popup-content">
            <span>@message</span>
            <button class="popup-close" onclick="closePopup()">×</button>
        </div>
    </div>
}

<div class="edit-museum-page">
    <!-- Hero Section -->
    <div class="edit-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="edit-header" data-aos="fade-up">
                <div class="edit-icon-wrapper">
                    <i class="fas fa-pen-to-square"></i>
                </div>
                <h1 class="edit-title">Edit Museum</h1>
                <p class="edit-subtitle">Update your museum information and ticket types</p>
            </div>
        </div>
    </div>

    <!-- Edit Form Section -->
    <div class="edit-form-section">
        <div class="container">
            <!-- Back Button -->
            <div class="back-button-wrapper" data-aos="fade-right">
                <a asp-controller="Worker" asp-action="MyMuseum" asp-route-id="@Model.MuseumId" class="btn-back-custom">
                    <i class="fas fa-arrow-left"></i>
                    Back to Museum
                </a>
            </div>

            <!-- Form Card -->
            <div class="edit-card" data-aos="fade-up" data-aos-delay="100">
                <form asp-controller="Worker" asp-action="EditMuseum" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MuseumId" />
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <!-- Museum Info Section -->
                    <div class="form-section">
                        <div class="section-header-custom">
                            <i class="fas fa-circle-info"></i>
                            <h3>Museum Information</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="Name" class="form-label-custom">
                                    <i class="fas fa-landmark"></i> Museum Name
                                </label>
                                <input asp-for="Name" class="form-control-custom" required />
                            </div>

                            <div class="form-group">
                                <label asp-for="Country" class="form-label-custom">
                                    <i class="fas fa-globe"></i> Country
                                </label>
                                <input asp-for="Country" class="form-control-custom" required />
                            </div>

                            <div class="form-group">
                                <label asp-for="City" class="form-label-custom">
                                    <i class="fas fa-city"></i> City
                                </label>
                                <input asp-for="City" class="form-control-custom" required />
                            </div>

                            <div class="form-group full-width">
                                <label asp-for="Address" class="form-label-custom">
                                    <i class="fas fa-location-dot"></i> Address
                                </label>
                                <input asp-for="Address" class="form-control-custom" />
                            </div>

                            <div class="form-group full-width">
                                <label asp-for="Description" class="form-label-custom">
                                    <i class="fas fa-align-left"></i> Description
                                </label>
                                <textarea asp-for="Description" class="form-control-custom" rows="4"></textarea>
                            </div>

                            <div class="form-group">
                                <label asp-for="OpeningTime" class="form-label-custom">
                                    <i class="fas fa-clock"></i> Opening Time
                                </label>
                                <input asp-for="OpeningTime" type="time" step="60" class="form-control-custom" />
                            </div>

                            <div class="form-group">
                                <label asp-for="ClosingTime" class="form-label-custom">
                                    <i class="fas fa-clock"></i> Closing Time
                                </label>
                                <input asp-for="ClosingTime" type="time" step="60" class="form-control-custom" />
                            </div>

                            <div class="form-group">
                                <label asp-for="Type" class="form-label-custom">
                                    <i class="fas fa-tag"></i> Museum Type
                                </label>
                                <input asp-for="Type" class="form-control-custom" />
                            </div>

                            <!-- Image URL -->
                            <div class="form-group full-width">
                                <label class="form-label-custom">
                                    <i class="fas fa-image"></i> Museum Image URL
                                </label>
                                <input type="url"
                                       id="imageUrl"
                                       name="ImageUrl"
                                       class="form-control-custom"
                                       placeholder="https://example.com/image.jpg"
                                       value="@(Model.Images?.FirstOrDefault()?.ImageUrl ?? "")" />
                                <div class="image-preview-container">
                                    <img id="imagePreview"
                                         src="@(Model.Images?.FirstOrDefault()?.ImageUrl ?? "")"
                                         alt="Image preview"
                                         style="display: @(Model.Images != null && Model.Images.Any() ? "block" : "none");" />
                                </div>
                                <div class="form-hint">Optional. Paste a public image URL.</div>
                            </div>
                        </div>
                    </div>

                    <div class="divider-custom"></div>

                    <!-- Ticket Types Section -->
                    <div class="form-section">
                        <div class="section-header-custom">
                            <i class="fas fa-ticket-alt"></i>
                            <h3>Ticket Types</h3>
                        </div>
                        <p class="section-description">Add ticket types for your museum. Leave empty rows to ignore.</p>

                        <button type="button" id="addTicketBtn" class="btn-add-ticket">
                            <i class="fas fa-plus"></i>
                            Add Ticket Type
                        </button>

                        <div id="ticketTypesContainer" class="tickets-container">
                            @for (int i = 0; i < ticketTypes.Count; i++)
                            {
                                var tt = ticketTypes[i];
                                <div class="ticket-row">
                                    <div class="ticket-row-content">
                                        <div class="ticket-field">
                                            <label class="ticket-label">Ticket Name</label>
                                            <input type="text"
                                                   name="TicketTypes[@i].Name"
                                                   class="form-control-custom"
                                                   value="@tt.Name"
                                                   placeholder="e.g., Adult, Child, Student"
                                                   required />
                                        </div>
                                        <div class="ticket-field">
                                            <label class="ticket-label">Price ($)</label>
                                            <input type="number"
                                                   name="TicketTypes[@i].Price"
                                                   step="0.01"
                                                   min="0"
                                                   class="form-control-custom"
                                                   value="@tt.Price"
                                                   placeholder="0.00"
                                                   required />
                                        </div>
                                        <div class="ticket-actions">
                                            <button type="button" class="btn-remove-ticket">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="divider-custom"></div>

                    <!-- Submit Button -->
                    <div class="form-actions">
                        <button type="submit" class="btn-save-changes">
                            <i class="fas fa-save"></i>
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Decorative Circles -->
    <ul class="circles">
        <li><i class="fa-solid fa-landmark"></i></li>
        <li><i class="fa-solid fa-building-columns"></i></li>
        <li><i class="fa-solid fa-monument"></i></li>
        <li><i class="fa-solid fa-gem"></i></li>
        <li><i class="fa-solid fa-scroll"></i></li>
        <li><i class="fa-solid fa-paint-roller"></i></li>
        <li><i class="fa-solid fa-palette"></i></li>
        <li><i class="fa-solid fa-book"></i></li>
        <li><i class="fa-solid fa-masks-theater"></i></li>
    </ul>
</div>

@section Scripts {
    <script>
        function closePopup() {
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                popup.classList.add('popup-hide');
                setTimeout(function() {
                    popup.style.display = 'none';
                }, 400);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const container = document.getElementById("ticketTypesContainer");
            const addBtn = document.getElementById("addTicketBtn");

            function getNextIndex() {
                const inputs = container.querySelectorAll("[name^='TicketTypes[']");
                let max = -1;
                inputs.forEach(el => {
                    const match = el.name.match(/TicketTypes\[(\d+)\]/);
                    if (match) {
                        const i = parseInt(match[1]);
                        if (i > max) max = i;
                    }
                });
                return max + 1;
            }

            function createRow(index) {
                const row = document.createElement("div");
                row.className = "ticket-row";
                row.innerHTML = `
                    <div class="ticket-row-content">
                        <div class="ticket-field">
                            <label class="ticket-label">Ticket Name</label>
                            <input type="text" name="TicketTypes[${index}].Name" class="form-control-custom" placeholder="e.g., Adult, Child, Student" required/>
                        </div>
                        <div class="ticket-field">
                            <label class="ticket-label">Price ($)</label>
                            <input type="number" name="TicketTypes[${index}].Price" step="0.01" min="0" class="form-control-custom" placeholder="0.00" required/>
                        </div>
                        <div class="ticket-actions">
                            <button type="button" class="btn-remove-ticket">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>`;
                return row;
            }

            addBtn.addEventListener("click", function () {
                const index = getNextIndex();
                const row = createRow(index);
                container.appendChild(row);
            });

            container.addEventListener("click", function (e) {
                if (e.target.closest(".btn-remove-ticket")) {
                    const row = e.target.closest(".ticket-row");
                    if (row) row.remove();
                }
            });

            // Image preview
            const imageInput = document.getElementById("imageUrl");
            const preview = document.getElementById("imagePreview");

            if (imageInput) {
                imageInput.addEventListener("input", function () {
                    const url = imageInput.value;
                    if (url) {
                        preview.src = url;
                        preview.style.display = "block";
                    } else {
                        preview.style.display = "none";
                    }
                });
            }

            // Auto-hide popup after 3s
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                setTimeout(function () {
                    popup.classList.add('popup-hide');
                    setTimeout(function() {
                        popup.style.display = 'none';
                    }, 400);
                }, 3000);
            }
        });
    </script>
}
