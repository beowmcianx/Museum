@model List<Museum.Models.MuseumModel>
@using System.Globalization

@{
    ViewData["Title"] = "Catalogue Page";
    ViewBag.HasHeroTitle = true;
}

<div class="catalogue-page">
    <!-- Hero Section -->
    <div class="catalogue-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="catalogue-header" data-aos="fade-up">
                <div class="catalogue-icon">
                    <i class="fas fa-landmark"></i>
                </div>
                <h1 class="catalogue-title">Discover The Right Museum</h1>
                <p class="catalogue-subtitle">Explore cultural treasures from around the world</p>
                <div class="hero-stats">
                    <span class="stat-badge">
                        <i class="fas fa-globe"></i> @ViewBag.TotalMuseums Museums
                    </span>
                    <span class="stat-badge">
                        <i class="fas fa-map-marker-alt"></i> @ViewBag.CountriesCount Countries
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Section -->
    <div class="filter-section container" data-aos="fade-up" data-aos-delay="100">
        <div class="filter-card">
            <div class="filter-header">
                <i class="fas fa-sliders-h"></i>
                <h3>Filter Museums</h3>
            </div>

            <form asp-controller="Museum" asp-action="Catalogue" method="get" class="filter-form">
                <!-- Search -->
                <div class="filter-group">
                    <label class="filter-label">
                        <i class="fas fa-search"></i> Search
                    </label>
                    <input class="filter-input"
                           type="search"
                           name="searchString"
                           value="@ViewBag.SearchString"
                           placeholder="Search by name, description, or location..." />
                </div>

                <div class="filter-row">
                    <!-- Country Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-flag"></i> Country
                        </label>
                        <select class="filter-select" name="countryFilter" id="countryFilter">
                            <option value="">All Countries</option>
                            @foreach (var country in ViewBag.Countries)
                            {
                                <option value="@country" selected="@(country == ViewBag.CountryFilter)">
                                    @country
                                </option>
                            }
                        </select>
                    </div>

                    <!-- City Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-city"></i> City
                        </label>
                        <select class="filter-select" name="cityFilter" id="cityFilter">
                            <option value="">All Cities</option>
                            @foreach (var city in ViewBag.Cities)
                            {
                                <option value="@city" selected="@(city == ViewBag.CityFilter)">
                                    @city
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Type Filter -->
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-landmark"></i> Museum Type
                        </label>
                        <select class="filter-select" name="typeFilter" id="typeFilter">
                            <option value="">All Types</option>
                            @foreach (var type in ViewBag.Types)
                            {
                                <option value="@type" selected="@(type == ViewBag.TypeFilter)">
                                    @type
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Filter Actions -->
                <div class="filter-actions">
                    <button class="btn-filter" type="submit">
                        <i class="fas fa-filter"></i> Apply Filters
                    </button>
                    <a class="btn-reset" asp-controller="Museum" asp-action="Catalogue">
                        <i class="fas fa-undo-alt"></i> Reset All
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Section -->
    <div class="results-section container">
        <div class="results-header" data-aos="fade-right">
            <div class="results-info">
                <i class="fas fa-museum"></i>
                <h2>Museums</h2>
                <span class="results-count">Showing @Model.Count museum@(Model.Count != 1 ? "s" : "")</span>
            </div>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="no-results" data-aos="fade-up">
                <div class="no-results-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3>No Museums Found</h3>
                @if (!string.IsNullOrEmpty(ViewBag.SearchString) ||
                            !string.IsNullOrEmpty(ViewBag.CountryFilter) ||
                            !string.IsNullOrEmpty(ViewBag.CityFilter) ||
                            !string.IsNullOrEmpty(ViewBag.TypeFilter))
                {
                    <p>No museums match your current filters. Try adjusting your search criteria.</p>
                }
                else
                {
                    <p>No museums are available at the moment. Check back soon!</p>
                }
                <a class="btn-outline-red" asp-controller="Museum" asp-action="Catalogue">
                    <i class="fas fa-undo-alt"></i> Clear All Filters
                </a>
            </div>
        }
        else
        {
            <div class="museums-grid">
                @{
                    var delay = 0;
                }
                @foreach (var museum in Model)
                {
                    var firstImageUrl = museum.Images?.FirstOrDefault()?.ImageUrl;
                    var open = DateTime.Today.Add(museum.OpeningTime);
                    var close = DateTime.Today.Add(museum.ClosingTime);

                    <div class="museum-card-item" data-aos="fade-up" data-aos-delay="@delay">
                        <div class="museum-card-inner">
                            <div class="card-image">
                                <img src="@(firstImageUrl ?? "/images/Image-not-found.png")"
                                     alt="@museum.Name">
                                <div class="card-overlay">
                                    <span class="museum-type-badge">@museum.Type</span>
                                </div>
                            </div>

                            <div class="card-content">
                                <h3 class="museum-name">@museum.Name</h3>

                                <div class="museum-location">
                                    <i class="fas fa-map-marker-alt"></i>
                                    <span>@museum.City, @museum.Country</span>
                                </div>

                                <div class="museum-address">
                                    <i class="fas fa-location-dot"></i>
                                    <span>@museum.Address</span>
                                </div>

                                <div class="museum-hours">
                                    <i class="far fa-clock"></i>
                                    <span>@open.ToString("h:mm tt", CultureInfo.InvariantCulture) - @close.ToString("h:mm tt", CultureInfo.InvariantCulture)</span>
                                </div>

                                <a class="btn-view-details" asp-controller="Museum" asp-action="Details" asp-route-id="@museum.MuseumId">
                                    <span>View Details</span>
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    delay += 50;
                    if (delay > 200) delay = 200;
                }
            </div>
        }

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination-section">
                <div class="pagination-info">
                    <i class="fas fa-chart-simple"></i>
                    <span>Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
                </div>

                <ul class="pagination-custom">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="Museum"
                               asp-action="Catalogue"
                               asp-route-page="@(ViewBag.CurrentPage - 1)"
                               asp-route-searchString="@ViewBag.SearchString"
                               asp-route-countryFilter="@ViewBag.CountryFilter"
                               asp-route-cityFilter="@ViewBag.CityFilter"
                               asp-route-typeFilter="@ViewBag.TypeFilter">
                                <i class="fas fa-chevron-left"></i> Previous
                            </a>
                        </li>
                    }

                    @{
                        int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                        int endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

                        if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Museum"
                                   asp-action="Catalogue"
                                   asp-route-page="1"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-countryFilter="@ViewBag.CountryFilter"
                                   asp-route-cityFilter="@ViewBag.CityFilter"
                                   asp-route-typeFilter="@ViewBag.TypeFilter">
                                    1
                                </a>
                            </li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-controller="Museum"
                                   asp-action="Catalogue"
                                   asp-route-page="@i"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-countryFilter="@ViewBag.CountryFilter"
                                   asp-route-cityFilter="@ViewBag.CityFilter"
                                   asp-route-typeFilter="@ViewBag.TypeFilter">
                                    @i
                                </a>
                            </li>
                        }

                        if (endPage < ViewBag.TotalPages)
                        {
                            if (endPage < ViewBag.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Museum"
                                   asp-action="Catalogue"
                                   asp-route-page="@ViewBag.TotalPages"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-countryFilter="@ViewBag.CountryFilter"
                                   asp-route-cityFilter="@ViewBag.CityFilter"
                                   asp-route-typeFilter="@ViewBag.TypeFilter">
                                    @ViewBag.TotalPages
                                </a>
                            </li>
                        }
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-controller="Museum"
                               asp-action="Catalogue"
                               asp-route-page="@(ViewBag.CurrentPage + 1)"
                               asp-route-searchString="@ViewBag.SearchString"
                               asp-route-countryFilter="@ViewBag.CountryFilter"
                               asp-route-cityFilter="@ViewBag.CityFilter"
                               asp-route-typeFilter="@ViewBag.TypeFilter">
                                Next <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>

</div>

<!-- Decorative Circles -->
<ul class="circles">
    <li><i class="fa-solid fa-landmark"></i></li>
    <li><i class="fa-solid fa-building-columns"></i></li>
    <li><i class="fa-solid fa-monument"></i></li>
    <li><i class="fa-solid fa-gem"></i></li>
    <li><i class="fa-solid fa-scroll"></i></li>
    <li><i class="fa-solid fa-paint-roller"></i></li>
    <li><i class="fa-solid fa-palette"></i></li>
    <li><i class="fa-solid fa-book"></i></li>
    <li><i class="fa-solid fa-masks-theater"></i></li>
</ul>

@section Scripts {
    <script>
        // Auto-submit form when country filter changes
        document.getElementById('countryFilter')?.addEventListener('change', function() {
            this.form.submit();
        });

        // Auto-submit form when city filter changes
        document.getElementById('cityFilter')?.addEventListener('change', function() {
            this.form.submit();
        });

        // Auto-submit form when type filter changes
        document.getElementById('typeFilter')?.addEventListener('change', function() {
            this.form.submit();
        });
    </script>
}

<script src="~/js/site.js" asp-append-version="true"></script>
