@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<link rel="stylesheet" href="~/css/page-error.css" asp-append-version="true" />

<div class="error-page">
    <!-- Hero Section -->
    <div class="error-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="error-header" data-aos="fade-up">
                <div class="error-icon-wrapper">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h1 class="error-title">Oops! Something Went Wrong</h1>
                <p class="error-subtitle">An error occurred while processing your request</p>
            </div>
        </div>
    </div>

    <!-- Error Content Section -->
    <div class="error-content-section">
        <div class="container">
            <div class="error-card" data-aos="fade-up" data-aos-delay="100">
                <!-- Error Message -->
                <div class="error-message">
                    <div class="error-code">
                        <span class="code-number">500</span>
                        <span class="code-text">Internal Server Error</span>
                    </div>

                    @if (Model.ShowRequestId)
                    {
                        <div class="request-id">
                            <i class="fas fa-id-card"></i>
                            <strong>Request ID:</strong>
                            <code>@Model.RequestId</code>
                        </div>
                    }
                </div>

                <div class="divider-custom"></div>

                <!-- Development Mode Warning -->
                <div class="development-warning">
                    <div class="warning-header">
                        <i class="fas fa-code-branch"></i>
                        <h3>Development Mode</h3>
                    </div>
                    <div class="warning-content">
                        <p>
                            Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
                        </p>
                        <div class="warning-box">
                            <i class="fas fa-exclamation-circle"></i>
                            <span>The Development environment shouldn't be enabled for deployed applications.</span>
                        </div>
                        <p>
                            It can result in displaying sensitive information from exceptions to end users.
                            For local debugging, enable the <strong>Development</strong> environment by setting the
                            <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
                            and restarting the app.
                        </p>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="error-actions">
                    <a asp-controller="Home" asp-action="Index" class="btn-home">
                        <i class="fas fa-home"></i>
                        Back to Home
                    </a>
                    <a href="javascript:history.back()" class="btn-go-back">
                        <i class="fas fa-arrow-left"></i>
                        Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Decorative Circles -->
    <ul class="circles">
        <li><i class="fa-solid fa-landmark"></i></li>
        <li><i class="fa-solid fa-building-columns"></i></li>
        <li><i class="fa-solid fa-monument"></i></li>
        <li><i class="fa-solid fa-gem"></i></li>
        <li><i class="fa-solid fa-scroll"></i></li>
        <li><i class="fa-solid fa-paint-roller"></i></li>
        <li><i class="fa-solid fa-palette"></i></li>
        <li><i class="fa-solid fa-book"></i></li>
        <li><i class="fa-solid fa-masks-theater"></i></li>
    </ul>
</div>
