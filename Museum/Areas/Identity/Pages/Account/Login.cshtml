@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <!-- Hero Section -->
    <div class="auth-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="auth-header" data-aos="fade-up">
                <div class="auth-icon-wrapper">
                    <i class="fas fa-right-to-bracket"></i>
                </div>
                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Log in to continue your cultural journey</p>
            </div>
        </div>
    </div>

    <!-- Login Form Section -->
    <div class="auth-form-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8" data-aos="fade-up" data-aos-delay="100">
                    <div class="auth-card">
                        <div class="auth-card-body">
                            <form id="account" method="post">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                                <!-- Email -->
                                <div class="form-group">
                                    <label asp-for="Input.Email" class="form-label">
                                        <i class="fas fa-envelope"></i>
                                        Email Address
                                    </label>
                                    <input asp-for="Input.Email"
                                           class="form-control-custom"
                                           autocomplete="username"
                                           placeholder="your@email.com" />
                                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                                </div>

                                <!-- Password -->
                                <div class="form-group">
                                    <label asp-for="Input.Password" class="form-label">
                                        <i class="fas fa-lock"></i>
                                        Password
                                    </label>
                                    <div class="password-input-wrapper">
                                        <input asp-for="Input.Password"
                                               type="password"
                                               class="form-control-custom"
                                               autocomplete="current-password"
                                               id="passwordInput"
                                               placeholder="Enter your password" />
                                        <button type="button" class="password-toggle" id="togglePassword">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                                </div>

                                <!-- Remember Me -->
                                <div class="checkbox-group">
                                    <input class="checkbox-custom" asp-for="Input.RememberMe" id="rememberMe" />
                                    <label class="checkbox-label" asp-for="Input.RememberMe">
                                        Remember me
                                    </label>
                                </div>

                                <!-- Submit Button -->
                                <button id="login-submit" type="submit" class="btn-auth-submit">
                                    <i class="fas fa-sign-in-alt"></i>
                                    Log In
                                </button>

                                <div class="auth-divider">
                                    <span>or</span>
                                </div>

                                <!-- Links -->
                                <div class="auth-links">
                                    <a asp-page="./ForgotPassword">
                                        <i class="fas fa-key"></i>
                                        Forgot your password?
                                    </a>
                                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                                        <i class="fas fa-user-plus"></i>
                                        Create new account
                                    </a>
                                    <a asp-page="./ResendEmailConfirmation">
                                        <i class="fas fa-envelope"></i>
                                        Resend email confirmation
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Decorative Circles -->
    <ul class="circles">
        <li><i class="fa-solid fa-landmark"></i></li>
        <li><i class="fa-solid fa-building-columns"></i></li>
        <li><i class="fa-solid fa-monument"></i></li>
        <li><i class="fa-solid fa-gem"></i></li>
        <li><i class="fa-solid fa-scroll"></i></li>
        <li><i class="fa-solid fa-paint-roller"></i></li>
        <li><i class="fa-solid fa-palette"></i></li>
        <li><i class="fa-solid fa-book"></i></li>
        <li><i class="fa-solid fa-masks-theater"></i></li>
    </ul>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Password toggle functionality
        const togglePassword = document.getElementById("togglePassword");
        const passwordInput = document.getElementById("passwordInput");

        if (togglePassword && passwordInput) {
            togglePassword.addEventListener("click", function () {
                const type = passwordInput.type === "password" ? "text" : "password";
                passwordInput.type = type;
                const icon = togglePassword.querySelector("i");
                icon.classList.toggle("fa-eye");
                icon.classList.toggle("fa-eye-slash");
            });
        }
    </script>
}
