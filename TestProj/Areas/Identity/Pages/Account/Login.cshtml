@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <!-- MAIN CARD ANIMATION -->
        <div class="col-lg-6 col-xl-5"
             data-aos="fade-up"
             data-aos-duration="800">

            <div class="card shadow-lg border-0 rounded-4">

                <!-- HEADER (subtle) -->
                <div class="card-header bg-dark text-white rounded-top-4 py-3"
                     data-aos="fade-down"
                     data-aos-duration="600">

                    <h4 class="mb-0">
                        <i class="fa-solid fa-right-to-bracket fa-lg"
                           style="color: #db4a2a; margin-right: 20px"></i>
                        Log in
                    </h4>

                </div>

                <!-- BODY -->
                <div class="card-body p-4"
                     data-aos="fade-up"
                     data-aos-duration="700">

                    <form id="account" method="post">

                        <h6 class="text-muted mb-3 text-uppercase fw-bold">
                            Account Access
                        </h6>

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"
                             role="alert">
                        </div>

                        <!-- EMAIL -->
                        <!-- EMAIL -->
                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label small text-muted">
                                <i class="fa-solid fa-envelope fa-sm" style="color: #db4a2b; margin-right: 6px;"></i>
                                Email
                            </label>
                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   autocomplete="username" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label small text-muted">
                                <i class="fa-solid fa-lock fa-sm" style="color: #db4a2b; margin-right: 6px;"></i>
                                Password
                            </label>

                            <div class="input-group">
                                <input asp-for="Input.Password"
                                       type="password"
                                       class="form-control form-control-lg"
                                       autocomplete="current-password"
                                       id="passwordInput" />
                                <button type="button"
                                        class="btn bg-white border"
                                        id="togglePassword">
                                    <i class="fa-solid fa-eye fa-lg" style="color:#db4a2b;"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <!-- REMEMBER ME -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label small text-muted" asp-for="Input.RememberMe">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <!-- BUTTON -->
                        <div class="d-grid mb-3">
                            <button id="login-submit" type="submit" class="btn btn-red btn-lg">
                                Log in
                            </button>
                        </div>

                        <hr class="my-4" />

                        <!-- LINKS -->
                        <div class="text-center small">
                            <p class="mb-2">
                                <a asp-page="./ForgotPassword" class="text-decoration-none">
                                    Forgot your password?
                                </a>
                            </p>
                            <p class="mb-2">
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none">
                                    Register as a new user
                                </a>
                            </p>
                            <p>
                                <a asp-page="./ResendEmailConfirmation" class="text-decoration-none">
                                    Resend email confirmation
                                </a>
                            </p>
                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        const togglePassword = document.getElementById("togglePassword");
        const passwordInput = document.getElementById("passwordInput");
        const icon = togglePassword.querySelector("i");

        togglePassword.addEventListener("click", function () {
            const type = passwordInput.type === "password" ? "text" : "password";
            passwordInput.type = type;
            icon.classList.toggle("fa-eye");
            icon.classList.toggle("fa-eye-slash");
        });
    </script>
}