@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-xl-5">

            <div class="card shadow-lg border-0 rounded-4">

                <!-- Card Header -->
                <div class="card-header bg-dark text-white rounded-top-4 py-3">
                    <h4 class="mb-0">
                        <i class="fa-solid fa-user-plus fa-lg"
                           style="color: #db4a2a; margin-right: 20px"></i>
                        Create Account
                    </h4>
                </div>

                <!-- Card Body -->
                <div class="card-body p-4">

                    <form id="registerForm"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <h6 class="text-muted mb-3 text-uppercase fw-bold">
                            Account Information
                        </h6>

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"
                             role="alert"></div>

                        <!-- Email -->
                        <div class="mb-4">
                            <label asp-for="Input.Email"
                                   class="form-label small text-muted"></label>
                            <input asp-for="Input.Email"
                                   class="form-control form-control-lg"
                                   autocomplete="username" />
                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="mb-4">
                            <label asp-for="Input.FullName"
                                   class="form-label small text-muted"></label>
                            <input asp-for="Input.FullName"
                                   class="form-control form-control-lg"
                                   autocomplete="name" />
                            <span asp-validation-for="Input.FullName"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-4">
                            <label asp-for="Input.Password"
                                   class="form-label small text-muted"></label>
                            <input asp-for="Input.Password"
                                   type="password"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Input.Password"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">
                            <label asp-for="Input.ConfirmPassword"
                                   class="form-label small text-muted"></label>
                            <input asp-for="Input.ConfirmPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Register Button -->
                        <div class="d-grid mb-3">
                            <button id="registerSubmit"
                                    type="submit"
                                    class="btn btn-red btn-lg">
                                Register
                            </button>
                        </div>

                        <hr class="my-4" />

                        <div class="text-center small">
                            <a asp-page="./Login"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="text-decoration-none">
                                Already have an account? Log in
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}