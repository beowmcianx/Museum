@page
@model IndexModel

@{
    ViewData["Title"] = "Profile";
}

<div class="profile-page">
    <!-- Hero Section -->
    <div class="profile-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="profile-header" data-aos="fade-up">
                <div class="profile-icon-wrapper">
                    <i class="fas fa-user-circle"></i>
                </div>
                <h1 class="profile-title">My Profile</h1>
                <p class="profile-subtitle">Manage your personal information and preferences</p>
            </div>
        </div>
    </div>

    <!-- Profile Content Section -->
    <div class="profile-content-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-10" data-aos="fade-up" data-aos-delay="100">
                    <div class="profile-card">
                        <div class="profile-card-body">
                            <!-- Account Information Section -->
                            <div class="info-section">
                                <div class="section-header">
                                    <i class="fas fa-id-card"></i>
                                    <h3>Account Information</h3>
                                </div>

                                <div class="info-grid">
                                    <div class="info-item">
                                        <label class="info-label">
                                            <i class="fas fa-user"></i>
                                            Username
                                        </label>
                                        <input value="@Model.Username" class="info-input" disabled />
                                    </div>

                                    <div class="info-item">
                                        <label class="info-label">
                                            <i class="fas fa-shield-alt"></i>
                                            Role
                                        </label>
                                        <input value="@Model.Role" class="info-input" disabled />
                                    </div>

                                    <div class="info-item full-width">
                                        <label class="info-label">
                                            <i class="fas fa-id-badge"></i>
                                            Full Name
                                        </label>
                                        <input value="@Model.FullName" class="info-input" disabled />
                                    </div>

                                    <div class="info-item full-width">
                                        <label class="info-label">
                                            <i class="fas fa-envelope"></i>
                                            Email Address
                                        </label>
                                        <input value="@Model.Email" class="info-input" disabled />
                                    </div>
                                </div>
                            </div>

                            <div class="divider"></div>

                            <!-- Contact Information Form -->
                            <div class="form-section">
                                <div class="section-header">
                                    <i class="fas fa-address-card"></i>
                                    <h3>Contact Information</h3>
                                </div>

                                <form method="post">
                                    <div class="form-group">
                                        <label asp-for="Input.PhoneNumber" class="form-label">
                                            <i class="fas fa-phone"></i>
                                            Phone Number
                                        </label>
                                        <input asp-for="Input.PhoneNumber"
                                               class="form-control-custom"
                                               placeholder="Enter your phone number" />
                                        <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                                    </div>

                                    <button type="submit" class="btn-save">
                                        <i class="fas fa-save"></i>
                                        Save Changes
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Decorative Circles -->
    <ul class="circles">
        <li><i class="fa-solid fa-landmark"></i></li>
        <li><i class="fa-solid fa-building-columns"></i></li>
        <li><i class="fa-solid fa-monument"></i></li>
        <li><i class="fa-solid fa-gem"></i></li>
        <li><i class="fa-solid fa-scroll"></i></li>
        <li><i class="fa-solid fa-paint-roller"></i></li>
        <li><i class="fa-solid fa-palette"></i></li>
        <li><i class="fa-solid fa-book"></i></li>
        <li><i class="fa-solid fa-masks-theater"></i></li>
    </ul>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<link rel="stylesheet" href="~/css/page-account.css" asp-append-version="true" />
