@model List<TestProj.Models.MuseumModel>

@{
    ViewData["Title"] = "Catalogue Page";
}

<body class="page-catalogue">
    <div class="text-center">

        <div class="text-center mb-4">

            <h1 class="display-5">
                <i class="fa-solid fa-landmark me-2" style="color:#db4a2a"></i>
                Discover The Right Museum
            </h1>
            <h5 class="text-secondary mb-4">Filter based on your interests</h5>
        </div>

        <br />

        @*Keep original search/filter card*@ 
        <div class="card mx-auto shadow-sm p-4 mb-5 rounded-5 page-catalogue-search-bar">
            <form asp-controller="Museum" asp-action="Catalogue" method="get" class="row g-2 align-items-center">

                <!-- Search -->
                <div class="col-md-4">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-search"></i>
                        </span>
                        <input class="form-control"
                               type="search"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               placeholder="Search anything..." />
                    </div>
                </div>

                <!-- Country Filter -->
                <div class="col-md-2">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-flag"></i>
                        </span>
                        <select class="form-select" name="countryFilter">
                            <option value="">All Countries</option>
                            @foreach (var country in ViewBag.Countries)
                            {
                                <option value="@country" selected="@(country == ViewBag.CountryFilter)">
                                    @country
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- City Filter -->
                <div class="col-md-2">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-city"></i>
                        </span>
                        <select class="form-select" name="cityFilter">
                            <option value="">All Cities</option>
                            @foreach (var city in ViewBag.Cities)
                            {
                                <option value="@city" selected="@(city == ViewBag.CityFilter)">
                                    @city
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Type Filter -->
                <div class="col-md-2">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-landmark"></i>
                        </span>
                        <select class="form-select" name="typeFilter">
                            <option value="">All Types</option>
                            @foreach (var type in ViewBag.Types)
                            {
                                <option value="@type" selected="@(type == ViewBag.TypeFilter)">
                                    @type
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Filter Button -->
                <div class="col-md-2">
                    <button class="btn btn-red w-100 d-flex align-items-center justify-content-center" type="submit">
                        <i class="fas fa-filter me-2"></i> Filter
                    </button>
                </div>

            </form>
        </div>

        <br />

        @*Museum Cards with improved styling only*@
        <div class="row g-4">

            @{
                var delay = 0;
            }

            @if (Model == null || !Model.Any())
            {
                <div class="col-12">
                    <div class="card shadow-lg rounded-5 p-5 text-center">

                        <i class="fa-solid fa-magnifying-glass fa-2x mb-3 text-secondary"></i>

                        @if (!string.IsNullOrEmpty(ViewBag.SearchString)
                                            || !string.IsNullOrEmpty(ViewBag.CountryFilter)
                                            || !string.IsNullOrEmpty(ViewBag.CityFilter)
                                            || !string.IsNullOrEmpty(ViewBag.TypeFilter))
                        {
                            <p class="text-muted mb-0">
                                No museums found matching your filters.
                            </p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No museums available yet.
                            </p>
                        }

                    </div>
                </div>
            }
            else
            {
                @foreach (var museum in Model)
                {
                    var firstImageUrl = museum.Images?.FirstOrDefault()?.ImageUrl;

                    <div class="col-sm-12 col-md-6 col-lg-4"
                         data-aos="zoom-in"
                         data-aos-delay="@delay">

                        <div class="card h-100 shadow-sm border-0 rounded-4 museum-card hover-scale">

                            <div class="card-header bg-dark text-white rounded-top-4 py-3">
                                <h5 class="mb-0">@museum.Name</h5>
                            </div>

                            <div class="card-body p-3">

                                <img src="@(firstImageUrl ?? "/images/Image-not-found.png")"
                                     alt="@museum.Name"
                                     class="img-fluid rounded-3 mb-3 w-100 shadow-sm"
                                     style="height: 200px; object-fit: cover;" />

                                <p class="mb-1 text-muted fs-6">
                                    <i class="fa-solid fa-location-dot me-2 text-danger"></i>
                                    @museum.Country, @museum.City
                                </p>

                                <p class="mb-2 text-muted fs-6">@museum.Address</p>

                                <p class="mb-3 text-muted fs-6">
                                    <i class="fa-solid fa-clock me-2 text-danger"></i>
                                    @(DateTime.Today.Add(museum.OpeningTime).ToString("h:mm tt").ToLowerInvariant())
                                    -
                                    @(DateTime.Today.Add(museum.ClosingTime).ToString("h:mm tt").ToLowerInvariant())
                                </p>

                                <div class="d-grid">
                                    <a class="btn btn-red shadow-sm"
                                       asp-controller="Museum"
                                       asp-action="Details"
                                       asp-route-id="@museum.MuseumId">
                                        View Details
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>

                    delay += 50;
                }
            }
        </div>

        @*Pagination like dashboard style*@
        <hr class="my-4" />
        <h5 class="text-center mb-3">
            Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages
        </h5>
        <nav>
            <ul class="pagination justify-content-center">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="Museum"
                           asp-action="Catalogue"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-countryFilter="@ViewBag.CountryFilter"
                           asp-route-cityFilter="@ViewBag.CityFilter"
                           asp-route-typeFilter="@ViewBag.TypeFilter">
                            Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-controller="Museum"
                           asp-action="Catalogue"
                           asp-route-page="@i"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-countryFilter="@ViewBag.CountryFilter"
                           asp-route-cityFilter="@ViewBag.CityFilter"
                           asp-route-typeFilter="@ViewBag.TypeFilter">
                            @i
                        </a>
                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="Museum"
                           asp-action="Catalogue"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-countryFilter="@ViewBag.CountryFilter"
                           asp-route-cityFilter="@ViewBag.CityFilter"
                           asp-route-typeFilter="@ViewBag.TypeFilter">
                            Next
                        </a>
                    </li>
                }
            </ul>
        </nav>

    </div>

    <ul class='circles'>
        <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
        <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
    </ul>

</body>

<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    document.querySelector('select[name="countryFilter"]')
        .addEventListener('change', function () {
            this.form.submit();
        });
</script>