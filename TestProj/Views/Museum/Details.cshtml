@model TestProj.Models.MuseumModel

@{
    ViewData["Title"] = $"{Model.Name}";
    var isClient = User.Identity?.IsAuthenticated == true && User.IsInRole("Client");
}

<!-- ===================== POPUP ALERT ===================== -->
@if (TempData["Success"] != null || TempData["Error"] != null)
{
    var isSuccess = TempData["Success"] != null;
    var message = isSuccess ? TempData["Success"] : TempData["Error"];

    <div id="ticketPopup"
         class="ticket-popup @(isSuccess ? "success" : "error")"
         data-aos="fade-left">

        <div class="popup-content">
            <span>@message</span>
            <button class="popup-close" onclick="closePopup()">×</button>
        </div>

    </div>
}

<div class="position-relative" style="margin: 0;">

    <!-- ===================== BACK BUTTON ===================== -->
    <form asp-controller="Museum"
          asp-action="Catalogue"
          method="post"
          class="mb-3">

        <button class="btn btn-outline-dark">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Back
        </button>

    </form>

    <!-- ===================== IMAGE CAROUSEL ===================== -->
    @if (Model.Images != null && Model.Images.Any())
    {
        <div id="museumHeroCarousel"
        class="carousel slide carousel-fade position-relative"
        data-bs-ride="carousel"
        data-bs-interval="5000">

            <!-- Carousel Images -->
            <div class="carousel-inner">

                @{
                    var first = true;
                    foreach (var image in Model.Images)
                    {
                        <div class="carousel-item @(first ? "active" : "")">
                            <div class="vh-100 d-flex align-items-center justify-content-center"
                                 style="background-image: url('@image.ImageUrl');
                                                    background-size: cover;
                                                    background-position: center;
                                                    position: relative;">

                                <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>

                                <div class="container position-relative text-white text-center">
                                    <h1 class="display-3 fw-bold text-red"
                                        data-aos="fade-down"
                                        data-aos-duration="800">
                                        @Model.Name
                                    </h1>

                                    <p class="lead"
                                       data-aos="fade-down"
                                       data-aos-duration="800">@Model.Country, @Model.City
                                    </p>

                                    <hr class="border-light w-50 mx-auto" />

                                    <p>
                                        @(DateTime.Today.Add(Model.OpeningTime).ToString("h:mm tt").ToLowerInvariant())
                                        -
                                        @(DateTime.Today.Add(Model.ClosingTime).ToString("h:mm tt").ToLowerInvariant())
                                    </p>

                                    @if (isClient)
                                    {
                                        <button type="button"
                                                class="btn btn-red btn-lg mt-3"
                                                data-bs-toggle="modal"
                                                data-bs-target="#buyTicketsModal">
                                            Tickets
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-area="Identity"
                                           asp-page="/Account/Login"
                                           class="btn btn-secondary btn-lg mt-3">
                                            Login as Client to Buy Tickets
                                        </a>
                                    }

                                </div>
                            </div>
                        </div>

                        first = false;
                    }
                }

            </div>

            <!-- Controls -->
            <button class="carousel-control-prev"
            type="button"
            data-bs-target="#museumHeroCarousel"
            data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next"
            type="button"
            data-bs-target="#museumHeroCarousel"
            data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>

        </div>
    }

    <hr class="hr-dark" />

    <!-- ===================== MUSEUM INFO ===================== -->
    <div class="row">
        <div class="col-md-4">
            <div class="container">

                <h4>
                    <i class="fa-solid fa-circle-info" style="margin-right: 12px;"></i> 
                    About
                </h4>
                <p>@Model.Description</p>
                <p><strong>Type - </strong> @Model.Type</p>
                <hr class="hr-dark" />

                <h4>
                    <i class="fa-regular fa-clock" style="margin-right: 12px;"></i> 
                    Working Hours
                </h4>

                <p class="fs-5">
                    @(DateTime.Today.Add(Model.OpeningTime).ToString("h:mm tt").ToLowerInvariant()) -
                    @(DateTime.Today.Add(Model.ClosingTime).ToString("h:mm tt").ToLowerInvariant())
                </p>
                <hr class="hr-dark" />

                <h4>
                    <i class="fa-solid fa-ticket" style="margin-right: 12px;"></i> 
                    Tickets
                </h4>

                @if (Model.TicketTypes != null && Model.TicketTypes.Any())
                {
                    <ul class="list-unstyled">
                        @for (var i = 0; i < Model.TicketTypes.Count; i++)
                        {
                            var tt = Model.TicketTypes.ElementAt(i);
                                
                            <li class="mb-2">
                                <p>@tt.Name — @tt.Price.ToString("F2") $</p>
                            </li>
                        }
                    </ul>
                }
                <hr class="hr-dark" />

            </div>
        </div>

        <!-- ===================== MAP ===================== -->
        <div class="col-md-6 offset-md-2">

            @if (!string.IsNullOrWhiteSpace(Model.Address))
            {
                <h4>
                    <i class="fa-solid fa-map" style="margin-right: 12px;"></i> 
                    @Model.Country, @Model.City,
                    <br>
                    <span class="text-muted" style="margin-left: 48px;">@Model.Address</span>
                </h4>

                <iframe width="100%"
                        height="450"
                        frameborder="0"
                        style="border: 2px solid #ccc; border-radius: 8px;"
                        src="https://www.google.com/maps?q=@Uri.EscapeDataString($"{Model.Country}, {Model.Address}, {Model.City}")&output=embed"
                        allowfullscreen>
                </iframe>
            }
        </div>
    </div>
    <hr class="hr-dark" />

    <!-- ===================== BUY TICKETS MODAL ===================== -->
    <div class="modal fade" id="buyTicketsModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">

                <form asp-controller="Museum" asp-action="BuyTickets" method="post">
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <h5 class="modal-title">Buy Tickets - @Model.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">

                        <input type="hidden" name="MuseumId" value="@Model.MuseumId" />

                        <div class="mb-3">
                            <label class="form-label"><strong>Visit date</strong></label>
                            <input name="VisitDate"
                                   type="date" 
                                   id="visitDate"
                                   class="form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   @(isClient ? "" : "disabled") />

                            <small id="sameDayWarning" class="text-red d-none">
                                Tickets purchased at the day of visit cannot be cancelled.
                            </small>
                        </div>

                        <hr />

                        <h5>Ticket types</h5>

                        @if (Model.TicketTypes != null && Model.TicketTypes.Any())
                        {
                            for (var i = 0; i < Model.TicketTypes.Count; i++)
                            {
                                var tt = Model.TicketTypes.ElementAt(i);

                                <div class="d-flex align-items-center mb-2">
                                    <div class="flex-grow-1">
                                        <strong>@tt.Name</strong> — @tt.Price.ToString("F2") $
                                    </div>

                                    <input type="hidden" name="Items[@i].TicketTypeId" value="@tt.TicketTypeId" />

                                    <input type="number"
                                           name="Items[@i].Quantity"
                                           class="form-control qty"
                                           style="width:100px;"
                                           min="0"
                                           max="20"
                                           value="0"
                                           data-price="@tt.Price"
                                           @(isClient ? "" : "disabled") />
                                </div>
                            }
                        }

                        <hr />

                        @if (isClient)
                        {
                            <div class="form-check mb-3">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="acceptRules"
                                       name="AcceptRules"
                                       value="true" />

                                <label class="form-check-label" for="acceptRules">
                                    I agree to the
                                    <a asp-controller="Home"
                                       asp-action="Rules"
                                       target="_blank">
                                        Rules & Terms
                                    </a>.
                                </label>
                            </div>
                        }

                        <div class="d-flex justify-content-between">
                            <strong>Total:</strong>
                            <span><span id="totalAmount">0.00</span> $</span>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Close
                        </button>

                        <button type="submit"
                                id="buyButton"
                                class="btn btn-red"
                                @(isClient ? "disabled" : "disabled")>
                            Buy
                        </button>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

<!-- ===================== STYLIZED BACKGROUND CIRCLES ===================== -->
<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

@section Scripts {
    <script>
        // ===================== TICKET TOTAL UPDATE =====================
        (function () {
            function updateTotal() {
                var total = 0.0;

                document.querySelectorAll('.qty').forEach(function (el) {
                    var qty = parseInt(el.value || '0', 10);
                    var price = parseFloat(el.getAttribute('data-price') || '0');

                    if (!isNaN(qty) && !isNaN(price)) {
                        total += qty * price;
                    }
                });

                document.getElementById('totalAmount').textContent = total.toFixed(2);
            }

            document.addEventListener('input', function (e) {
                if (e.target && e.target.classList.contains('qty')) {
                    updateTotal();
                }
            });

            var acceptCheckbox = document.getElementById('acceptRules');
            var buyButton = document.getElementById('buyButton');

            if (acceptCheckbox && buyButton) {
                buyButton.disabled = true;

                acceptCheckbox.addEventListener('change', function () {
                    buyButton.disabled = !this.checked;
                });
            }

            updateTotal();
        })();

        // ===================== SAME-DAY WARNING =====================
        var visitDateInput = document.getElementById("visitDate");
        var sameDayWarning = document.getElementById("sameDayWarning");

        function checkVisitDate() {
            if (!visitDateInput) return;

            var selected = visitDateInput.value;
            var today = new Date().toISOString().split('T')[0];

            if (selected === today) {
                sameDayWarning.classList.remove("d-none");
            } else {
                sameDayWarning.classList.add("d-none");
            }
        }

        if (visitDateInput) {
            visitDateInput.addEventListener("change", checkVisitDate);
            checkVisitDate();
        }
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ===================== AOS INIT ===================== -->
    <link href="https://unpkg.com/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
    <script>
        AOS.init({
            duration: 600,
            once: true
        });
    </script>
}
