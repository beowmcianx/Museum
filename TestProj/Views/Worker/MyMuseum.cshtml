@model TestProj.Models.MuseumModel

@{
    ViewData["Title"] = $"My Museum - {Model.Name}";
    ViewBag.HasHeroTitle = true;
}

@if (TempData["Success"] != null || TempData["Error"] != null)
{
    var isSuccess = TempData["Success"] != null;
    var message = isSuccess ? TempData["Success"] : TempData["Error"];

    <div id="ticketPopup" class="ticket-popup @(isSuccess ? "success" : "error")">
        <div class="popup-content">
            <span>@message</span>
            <button class="popup-close" onclick="closePopup()">×</button>
        </div>
    </div>
}

<div class="my-museum-page">
    <!-- Hero Section -->
    <div class="museum-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="welcome-card" data-aos="fade-down">
                <div class="welcome-greeting">
                    <i class="fas fa-hand-peace"></i>
                    <span>Welcome back, 
                        @(User.Identity?.Name ?? "Guest")
                    </span>
                </div>
            </div>

            <div class="museum-header" data-aos="fade-up" data-aos-delay="100">
                <h1 class="museum-title">@Model.Name</h1>
                <div class="museum-badges">
                    <span class="badge-custom">
                        <i class="fas fa-map-marker-alt"></i> @Model.Type
                    </span>
                </div>
                <p class="museum-subtitle">
                    Manage your exhibitions, track visitor orders, and curate cultural experiences
                </p>
            </div>
        </div>
    </div>

    <!-- Dashboard Actions -->
    <div class="dashboard-section container">
        <div class="section-header" data-aos="fade-right">
            <h2>Museum Management</h2>
            <p>Control panel for your cultural institution</p>
        </div>

        <div class="actions-wrapper">
            <a class="action-card" asp-action="EditMuseum" asp-route-id="@Model.MuseumId" data-aos="fade-up" data-aos-delay="200">
                <div class="card-icon museum-icon-bg">
                    <i class="fas fa-landmark"></i>
                </div>
                <div class="card-content">
                    <h3>Museum Profile</h3>
                    <p>Edit museum details, update information, and manage settings</p>
                    <div class="card-footer">
                        <span>Manage Profile</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>

            <a class="action-card" asp-action="MuseumOrders" asp-route-id="@Model.MuseumId" data-aos="fade-up" data-aos-delay="300">
                <div class="card-icon orders-icon-bg">
                    <i class="fas fa-ticket-alt"></i>
                </div>
                <div class="card-content">
                    <h3>Ticket Orders</h3>
                    <p>View and manage visitor bookings, track sales, and analyze attendance</p>
                    <div class="card-footer">
                        <span>View Orders</span>
                        <i class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Quick Stats Section (Optional - if you want to add stats later) -->
    <div class="stats-section container" style="display: none;">
        <div class="stats-grid">
            <div class="stat-card">
                <i class="fas fa-users"></i>
                <h3>0</h3>
                <p>Total Visitors</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-ticket"></i>
                <h3>0</h3>
                <p>Tickets Sold</p>
            </div>
            <div class="stat-card">
                <i class="fas fa-chart-line"></i>
                <h3>0</h3>
                <p>Revenue</p>
            </div>
        </div>
    </div>
</div>

<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

<script src="~/js/site.js" asp-append-version="true"></script>

@section Scripts {
    <script>
        function closePopup() {
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                popup.classList.add('popup-hide');
                setTimeout(function() {
                    popup.style.display = 'none';
                }, 400);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                setTimeout(function() {
                    popup.classList.add('popup-hide');
                    setTimeout(function() {
                        popup.style.display = 'none';
                    }, 400);
                }, 3000);
            }
        });
    </script>
}