@model TestProj.Models.NewFolder.AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="container mt-5">

    

    <!-- HEADER -->
    <div class="text-center mb-4">
        <h1 class="display-5">
            <i class="fa-solid fa-chart-simple me-2" style="color:#db4a2a"></i>
            Museum Analytics
        </h1>
        <span class="text-secondary">Overview of purchases and visits</span>
    </div>

    <br />

    <!-- BACK BUTTON -->
    <form asp-controller="Dashboard"
          asp-action="Dashboard"
          method="post"
          class="mb-3">
        <button class="btn btn-outline-dark">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Back
        </button>
    </form>

    <!-- SEARCH BAR -->
    <div class="card mx-auto shadow-sm p-4 mb-4 rounded-5 page-catalogue-search-bar">
        <form method="get" class="row g-2 align-items-center">

            <!-- FROM -->
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white fw-semibold text-nowrap px-3">
                         From
                    </span>
                    <input type="date"
                           id="startDate"
                           name="startDate"
                           value="@ViewBag.StartDate"
                           class="form-control" />
                </div>
            </div>

            <!-- TO -->
            <div class="col-md-3">
                <div class="input-group">
                    <input type="date"
                           id="endDate"
                           name="endDate"
                           value="@ViewBag.EndDate"
                           class="form-control" />
                </div>
            </div>

            <!-- FILTER -->
            <div class="col-md-4 d-grid">
                <button class="btn btn-red h-100">
                    <i class="fas fa-filter me-2"></i> Filter
                </button>
            </div>


            <!-- ALL TIME -->
            <div class="col-md-2 d-grid">
                <a class="btn btn-dark h-100 d-flex align-items-center justify-content-center"
                   href="@Url.Action("Analytics", "Dashboard")">
                    All Time
                </a>
            </div>

        </form>
    </div>

    <br />

    @if (ViewBag.IsAllTime == true)
    {
        <p class="text-muted">
            Showing All Results
        </p>
    }
    else
    {
        <p class="text-muted">
            Showing results from @DateTime.Parse(ViewBag.StartDate).ToString("dd MMM yyyy")
            to @DateTime.Parse(ViewBag.EndDate).ToString("dd MMM yyyy")
        </p>
    }

    <!-- STATS -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow p-3 rounded-4">
                <h5><i class="fa-solid fa-cart-shopping me-2"></i>Total Orders</h5>
                <h2>@Model.TotalOrders</h2>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow p-3 rounded-4">
                <h5><i class="fa-solid fa-ticket me-2"></i>Total Tickets Sold</h5>
                <h2>@Model.TotalTickets</h2>
            </div>
        </div>
    </div>

    <!-- TOP MUSEUMS -->
    <div class="card mb-4 shadow rounded-5">
        <div class="card-header bg-red text-white rounded-top-5">
            <h5 class="mb-0"><i class="fa-solid fa-landmark me-2"></i>Top Museums by Tickets Sold</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th><i class="fa-solid fa-landmark me-1"></i>Museum</th>
                        <th><i class="fa-solid fa-ticket me-1"></i>Tickets Sold</th>
                        <th><i class="fa-solid fa-cart-shopping me-1"></i>Orders</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.TopMuseums)
                    {
                        <tr>
                            <td>@m.Museum.Name</td>
                            <td>@m.TicketsSold</td>
                            <td>@m.OrdersCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- CITY -->
    <div class="card mb-4 shadow rounded-5">
        <div class="card-header bg-red text-white rounded-top-5">
            <h5 class="mb-0"><i class="fa-solid fa-city me-2"></i>Purchases by City</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th><i class="fa-solid fa-city me-1"></i>City</th>
                        <th><i class="fa-solid fa-ticket me-1"></i>Tickets Sold</th>
                        <th><i class="fa-solid fa-cart-shopping me-1"></i>Orders</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CityStats)
                    {
                        <tr>
                            <td>@c.City</td>
                            <td>@c.TicketsSold</td>
                            <td>@c.OrdersCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- COUNTRY -->
    <div class="card mb-4 shadow rounded-5">
        <div class="card-header bg-red text-white rounded-top-5">
            <h5 class="mb-0"><i class="fa-solid fa-flag me-2"></i>Purchases by Country</h5>
        </div>
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th><i class="fa-solid fa-flag me-1"></i>Country</th>
                        <th><i class="fa-solid fa-ticket me-1"></i>Tickets Sold</th>
                        <th><i class="fa-solid fa-cart-shopping me-1"></i>Orders</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CountryStats)
                    {
                        <tr>
                            <td>@c.Country</td>
                            <td>@c.TicketsSold</td>
                            <td>@c.OrdersCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- BACKGROUND ICONS -->
<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const startInput = document.getElementById("startDate");
        const endInput = document.getElementById("endDate");

        function updateLimits() {
            if (startInput.value) endInput.min = startInput.value;
            else endInput.min = "";

            if (endInput.value) startInput.max = endInput.value;
            else startInput.max = "";
        }

        updateLimits();
        startInput.addEventListener("change", updateLimits);
        endInput.addEventListener("change", updateLimits);
    });
</script>