@model List<TestProj.Models.MuseumModel>

@{
    ViewData["Title"] = "Dashboard";
}

<!-- ===================== POPUP ALERT ===================== -->
@if (TempData["Success"] != null || TempData["Error"] != null)
{
    var isSuccess = TempData["Success"] != null;
    var message = isSuccess ? TempData["Success"] : TempData["Error"];

    <div id="ticketPopup"
         class="ticket-popup @(isSuccess ? "success" : "error")">

        <div class="popup-content">
            <span>@message</span>
            <button class="popup-close" onclick="closePopup()">×</button>
        </div>

    </div>
}

<div class="ocean">
    <div class="wave"></div>
    <div class="wave"></div>
</div>

<body class="page-catalogue">

    <div class="container mt-4">

        <div class="text-center mb-4">
            <h1 class="display-5">
                <i class="fa-solid fa-gauge-high me-2" style="color:#db4a2a"></i>
                Dashboard
            </h1>

            <h5 class="text-secondary">
                View, create and manage museums & accounts
            </h5>
        </div>

        <hr />

        <!-- Dashboard actions -->
        <h3 class="text-center mb-4">
            <i class="fa-solid fa-sliders me-2 text-danger"></i>
            Administration
        </h3>

        <div class="row g-3 mb-5">

            <div class="col-md-4">
                <a class="btn btn-red page-dashboard-button w-100 text-center p-4"
                   asp-controller="Dashboard"
                   asp-action="Create">

                    <i class="fas fa-landmark fa-2x mb-2"></i><br />
                    Create Museum

                </a>
            </div>

            <div class="col-md-4">
                <a class="btn btn-red page-dashboard-button w-100 text-center p-4"
                   asp-controller="Dashboard"
                   asp-action="Accounts">

                    <i class="fa-solid fa-users fa-2x mb-2"></i><br />
                    Manage Accounts

                </a>
            </div>

            <div class="col-md-4">
                <a class="btn btn-red page-dashboard-button w-100 text-center p-4"
                   asp-controller="Dashboard"
                   asp-action="Analytics">

                    <i class="fa-solid fa-chart-simple fa-2x mb-2"></i><br />
                    Analytics

                </a>
            </div>

        </div>

        <hr />

        <!-- Museums Section -->
        <h3 class="text-center mb-4">
            <i class="fa-solid fa-landmark text-danger me-2"></i>
            Museums
        </h3>

        <!-- Search card -->
        <div class="card mx-auto shadow-sm p-4 mb-4 rounded-5 page-catalogue-search-bar">

            <form asp-controller="Dashboard"
                  asp-action="Dashboard"
                  method="get"
                  class="row g-2 align-items-center">

                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-search"></i>
                        </span>

                        <input class="form-control"
                               type="search"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               placeholder="Search anything..." />
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-flag"></i>
                        </span>

                        <select class="form-select" name="countryFilter">
                            <option value="">All Countries</option>

                            @foreach (var country in ViewBag.Countries)
                            {
                                <option value="@country"
                                        selected="@(country == ViewBag.CountryFilter)">
                                    @country
                                </option>
                            }

                        </select>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-city"></i>
                        </span>

                        <select class="form-select" name="cityFilter">
                            <option value="">All Cities</option>

                            @foreach (var city in ViewBag.Cities)
                            {
                                <option value="@city"
                                        selected="@(city == ViewBag.CityFilter)">
                                    @city
                                </option>
                            }

                        </select>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-landmark"></i>
                        </span>

                        <select class="form-select" name="typeFilter">
                            <option value="">All Types</option>

                            @foreach (var type in ViewBag.Types)
                            {
                                <option value="@type"
                                        selected="@(type == ViewBag.TypeFilter)">
                                    @type
                                </option>
                            }

                        </select>
                    </div>
                </div>

                <div class="col-md-2">
                    <button class="btn btn-red w-100">
                        <i class="fas fa-filter me-2"></i> Filter
                    </button>
                </div>

            </form>

        </div>

        <!-- Museums Table -->
        <div class="card shadow-lg rounded-5 p-3">

            <div class="card-body">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Type</th>
                            <th>Working Hours</th>
                            <th>Active</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var museum in Model)
                        {
                            <tr>

                                <td>@museum.MuseumId</td>

                                <td>
                                    <strong>@museum.Name</strong>
                                </td>

                                <td>
                                    @museum.Country, @museum.City
                                    <br />
                                    <small class="text-muted">@museum.Address</small>
                                </td>

                                <td>@museum.Type</td>

                                <td>
                                    @(DateTime.Today.Add(museum.OpeningTime).ToString("h:mm tt").ToLowerInvariant())
                                    -
                                    @(DateTime.Today.Add(museum.ClosingTime).ToString("h:mm tt").ToLowerInvariant())
                                </td>

                                <td>
                                    @if (museum.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <a class="btn btn-sm btn-red"
                                           asp-controller="Dashboard"
                                           asp-action="Edit"
                                           asp-route-id="@museum.MuseumId">

                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <form asp-controller="Dashboard"
                                              asp-action="Delete"
                                              asp-route-id="@museum.MuseumId"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Delete this museum?');">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <hr />

        <h5 class="text-center">
            Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages
        </h5>

        <!-- Pagination -->
        <nav>

            <ul class="pagination justify-content-center">

                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Dashboard"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-countryFilter="@ViewBag.CountryFilter"
                           asp-route-cityFilter="@ViewBag.CityFilter"
                           asp-route-typeFilter="@ViewBag.TypeFilter">
                            Previous
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">

                        <a class="page-link"
                           asp-action="Dashboard"
                           asp-route-page="@i"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-countryFilter="@ViewBag.CountryFilter"
                           asp-route-cityFilter="@ViewBag.CityFilter"
                           asp-route-typeFilter="@ViewBag.TypeFilter">

                            @i

                        </a>

                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-action="Dashboard"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-searchString="@ViewBag.SearchString"
                           asp-route-countryFilter="@ViewBag.CountryFilter"
                           asp-route-cityFilter="@ViewBag.CityFilter"
                           asp-route-typeFilter="@ViewBag.TypeFilter">
                            Next
                        </a>
                    </li>
                }

            </ul>

        </nav>

    </div>

</body>

<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

<script src="~/js/site.js" asp-append-version="true"></script>

<script>
        document.addEventListener("DOMContentLoaded", function () {

        const deleteButtons = document.querySelectorAll(".btn-danger");

        deleteButtons.forEach(button => {

            button.addEventListener("click", function (e) {

                if (!confirm("Are you sure you want to delete this museum?")) {
                    e.preventDefault();
                }

            });

        });

    });
</script>
