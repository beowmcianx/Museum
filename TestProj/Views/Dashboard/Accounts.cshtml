@using TestProj.Models.NewFolder
@model List<AccountViewModel>

@{
    ViewData["Title"] = "Manage Accounts";
    ViewBag.HasHeroTitle = true;

    var availableRoles = ViewBag.Roles as List<string> ?? new List<string>();
    var museums = ViewBag.Museums as List<TestProj.Models.MuseumModel> ?? new List<TestProj.Models.MuseumModel>();

    string search = ViewBag.Search ?? "";
    string roleFilter = ViewBag.RoleFilter ?? "";
    string museumFilter = ViewBag.MuseumFilter ?? "";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<!-- Popup Alert -->
@if (TempData["Success"] != null || TempData["Error"] != null)
{
    var isSuccess = TempData["Success"] != null;
    var message = isSuccess ? TempData["Success"] : TempData["Error"];

    <div id="ticketPopup" class="ticket-popup @(isSuccess ? "success" : "error")" data-aos="fade-left">
        <div class="popup-content">
            <span>@message</span>
            <button class="popup-close" onclick="closePopup()">×</button>
        </div>
    </div>
}

<div class="accounts-page">
    <!-- Hero Section -->
    <div class="accounts-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="accounts-header" data-aos="fade-up">
                <div class="accounts-icon-wrapper">
                    <i class="fas fa-users-cog"></i>
                </div>
                <h1 class="accounts-title">Manage Accounts</h1>
                <p class="accounts-subtitle">View and edit information for all user accounts</p>
            </div>
        </div>
    </div>

    <!-- Content Section -->
    <div class="accounts-content-section">
        <div class="container">
            <!-- Back Button -->
            <div class="back-button-wrapper" data-aos="fade-right">
                <a asp-controller="Dashboard" asp-action="Dashboard" class="btn-back-custom">
                    <i class="fas fa-arrow-left"></i>
                    Back to Dashboard
                </a>
            </div>

            <!-- Filter Card -->
            <div class="filter-card" data-aos="fade-up" data-aos-delay="100">
                <div class="filter-header">
                    <i class="fas fa-filter"></i>
                    <h3>Filter Accounts</h3>
                </div>

                <form asp-controller="Dashboard" asp-action="Accounts" method="get" class="filter-form">
                    <div class="filter-row">
                        <div class="filter-group">
                            <label class="filter-label">
                                <i class="fas fa-search"></i> Search
                            </label>
                            <input type="text"
                                   name="search"
                                   class="filter-input"
                                   value="@search"
                                   placeholder="Search by username or email..." />
                        </div>

                        <div class="filter-group">
                            <label class="filter-label">
                                <i class="fas fa-user-tag"></i> Role
                            </label>
                            <select name="roleFilter" class="filter-select">
                                <option value="">All Roles</option>
                                @foreach (var role in availableRoles)
                                {
                                    <option value="@role" selected="@(role == roleFilter)">@role</option>
                                }
                            </select>
                        </div>

                        <div class="filter-group">
                            <label class="filter-label">
                                <i class="fas fa-landmark"></i> Museum
                            </label>
                            <select name="museumFilter" class="filter-select">
                                <option value="">All Museums</option>
                                @foreach (var museum in museums)
                                {
                                    <option value="@museum.MuseumId" selected="@(museumFilter == museum.MuseumId.ToString())">@museum.Name</option>
                                }
                            </select>
                        </div>

                        <div class="filter-group filter-actions-group">
                            <label class="filter-label">&nbsp;</label>
                            <button type="submit" class="btn-filter">
                                <i class="fas fa-filter"></i> Apply Filters
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Accounts Table -->
            <div class="table-card" data-aos="fade-up" data-aos-delay="200">
                <div class="table-responsive">
                    <table class="accounts-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-id-badge"></i> ID</th>
                                <th><i class="fas fa-user"></i> Username</th>
                                <th><i class="fas fa-envelope"></i> Email</th>
                                <th><i class="fas fa-user-shield"></i> Role</th>
                                <th><i class="fas fa-landmark"></i> Assigned Museum</th>
                                <th><i class="fas fa-cog"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model)
                            {
                                <tr class="account-row">
                                    <form asp-controller="Dashboard" asp-action="UpdateRole" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@account.Id" />
                                        <input type="hidden" name="search" value="@search" />
                                        <input type="hidden" name="page" value="@currentPage" />

                                    <td class="user-id">@account.Id</td>
                                    <td class="username">
                                        <i class="fas fa-user-circle"></i>
                                            @account.UserName
                                    </td>
                                    <td class="user-email">@account.Email</td>

                                    <!-- Role Selection -->
                                    <td class="role-cell">
                                        <select name="newRole" class="role-select-custom">
                                            <option value="">(none)</option>
                                                @foreach (var r in availableRoles)
                                                {
                                                <option value="@r" selected="@(r == account.CurrentRole)">
                                                        @r
                                                </option>
                                                }
                                        </select>
                                    </td>

                                    <!-- Museum Selection -->
                                    <td class="museum-cell">
                                        <select name="museumId"
                                                class="museum-select-custom"
                                            @(account.CurrentRole != "Worker" ? "disabled" : "")>
                                            <option value="">(no museum)</option>
                                                @foreach (var museum in museums)
                                                {
                                                <option value="@museum.MuseumId" selected="@(museum.MuseumId == account.AssignedMuseumId)">
                                                        @museum.Name
                                                </option>
                                                }
                                        </select>
                                    </td>

                                    <!-- Save Button -->
                                    <td class="actions-cell">
                                        <button type="submit" class="btn-save-account">
                                            <i class="fas fa-save"></i>
                                            Save
                                        </button>
                                    </td>
                                    </form>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="pagination-section" data-aos="fade-up">
                    <div class="pagination-info">
                        <i class="fas fa-chart-simple"></i>
                        <span>Showing page @currentPage of @totalPages</span>
                    </div>

                    <ul class="pagination-custom">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Dashboard" asp-action="Accounts"
                                   asp-route-search="@search" asp-route-roleFilter="@roleFilter"
                                   asp-route-museumFilter="@museumFilter" asp-route-page="@(currentPage - 1)">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </a>
                            </li>
                        }

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Dashboard" asp-action="Accounts"
                                       asp-route-search="@search" asp-route-roleFilter="@roleFilter"
                                       asp-route-museumFilter="@museumFilter" asp-route-page="1">1</a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-controller="Dashboard" asp-action="Accounts"
                                       asp-route-search="@search" asp-route-roleFilter="@roleFilter"
                                       asp-route-museumFilter="@museumFilter" asp-route-page="@i">@i</a>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-controller="Dashboard" asp-action="Accounts"
                                       asp-route-search="@search" asp-route-roleFilter="@roleFilter"
                                       asp-route-museumFilter="@museumFilter" asp-route-page="@totalPages">@totalPages</a>
                                </li>
                            }
                        }

                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-controller="Dashboard" asp-action="Accounts"
                                   asp-route-search="@search" asp-route-roleFilter="@roleFilter"
                                   asp-route-museumFilter="@museumFilter" asp-route-page="@(currentPage + 1)">
                                    Next <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Decorative Circles -->
    <ul class="circles">
        <li><i class="fa-solid fa-landmark"></i></li>
        <li><i class="fa-solid fa-building-columns"></i></li>
        <li><i class="fa-solid fa-monument"></i></li>
        <li><i class="fa-solid fa-gem"></i></li>
        <li><i class="fa-solid fa-scroll"></i></li>
        <li><i class="fa-solid fa-paint-roller"></i></li>
        <li><i class="fa-solid fa-palette"></i></li>
        <li><i class="fa-solid fa-book"></i></li>
        <li><i class="fa-solid fa-masks-theater"></i></li>
    </ul>
</div>

@section Scripts {
    <script>
        function closePopup() {
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                popup.classList.add('popup-hide');
                setTimeout(function() {
                    popup.style.display = 'none';
                }, 400);
            }
        }

        document.addEventListener("DOMContentLoaded", function(){
            // Auto-hide popup after 3 seconds
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                setTimeout(function() {
                    popup.classList.add('popup-hide');
                    setTimeout(function() {
                        popup.style.display = 'none';
                    }, 400);
                }, 3000);
            }

            // Role select change handler
            const roleSelects = document.querySelectorAll(".role-select-custom");

            roleSelects.forEach(function(roleSelect){
                const row = roleSelect.closest("tr");
                const museumSelect = row.querySelector(".museum-select-custom");

                function updateState(){
                    if(roleSelect.value === "Worker"){
                        museumSelect.removeAttribute("disabled");
                        museumSelect.style.opacity = "1";
                        museumSelect.style.cursor = "pointer";
                    } else {
                        museumSelect.value = "";
                        museumSelect.setAttribute("disabled", "disabled");
                        museumSelect.style.opacity = "0.5";
                        museumSelect.style.cursor = "not-allowed";
                    }
                }

                roleSelect.addEventListener("change", updateState);
                updateState();
            });
        });
    </script>
}