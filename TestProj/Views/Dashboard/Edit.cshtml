@model TestProj.Models.MuseumModel

@{
    ViewData["Title"] = $"Edit: {Model.Name}";
    var imageUrl = Model.Images?.FirstOrDefault()?.ImageUrl ?? "";
}

<body class="page-catalogue">

    <div class="container mt-5">

        <div class="text-center mb-4">
            <h1 class="display-5">
                <i class="fa-solid fa-pen-to-square me-2" style="color:#db4a2a"></i>
                Edit Museum
            </h1>

            <h4 class="text-secondary">@Model.Name</h4>
        </div>

        <form asp-controller="Dashboard"
              asp-action="Dashboard"
              method="post"
              class="mb-3">

            <button class="btn btn-outline-dark">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back
            </button>

        </form>

        <div class="card shadow-lg rounded-5 p-4">

            <form asp-controller="Dashboard"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="MuseumId" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <h4 class="mb-3">
                    <i class="fa-solid fa-circle-info text-danger me-2"></i>
                    Museum Info
                </h4>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Country"></label>
                        <input asp-for="Country" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="City"></label>
                        <input asp-for="City" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Address"></label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="OpeningTime"></label>
                        <input asp-for="OpeningTime" type="time" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ClosingTime"></label>
                        <input asp-for="ClosingTime" type="time" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Type"></label>
                        <input asp-for="Type" class="form-control" />
                    </div>

                    <div class="col-md-12">

                        <label class="form-label">
                            <i class="fa-solid fa-image text-danger me-2"></i>
                            Museum Image URL
                        </label>

                        <input type="url"
                               id="imageUrl"
                               name="ImageUrl"
                               value="@imageUrl"
                               class="form-control"
                               placeholder="https://example.com/image.jpg" />

                        <div class="mt-3 text-center">

                            <img id="imagePreview"
                                 src="@imageUrl"
                                 class="shadow"
                                 style="max-height:250px;border-radius:12px;@(string.IsNullOrEmpty(imageUrl) ? "display:none;" : "")" />

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <h4>
                    <i class="fa-solid fa-ticket text-danger me-2"></i>
                    Ticket Types
                </h4>

                <div class="mb-3">
                    <button type="button"
                            id="addTicketBtn"
                            class="btn btn-red">

                        <i class="fa-solid fa-plus me-2"></i>
                        Add Ticket

                    </button>
                </div>

                <div id="ticketTypesContainer">

                    @if (Model.TicketTypes != null && Model.TicketTypes.Any())
                    {
                        for (int i = 0; i < Model.TicketTypes.Count; i++)
                        {
                            var ticket = Model.TicketTypes.ElementAt(i);

                            <div class="ticket-row card p-3 mb-2 shadow-sm border-0 rounded-4">

                                <div class="row g-2 align-items-center">

                                    <div class="col-md-5">

                                        <input type="text"
                                               name="TicketTypes[@i].Name"
                                               value="@ticket.Name"
                                               class="form-control"
                                               placeholder="Ticket type"
                                               required />

                                    </div>

                                    <div class="col-md-3">

                                        <input type="number"
                                               name="TicketTypes[@i].Price"
                                               value="@ticket.Price"
                                               step="0.01"
                                               class="form-control"
                                               placeholder="Price"
                                               required />

                                    </div>

                                    <div class="col-md-2">

                                        <button type="button"
                                                class="btn btn-red remove-ticket">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>

                                    </div>

                                </div>

                            </div>
                        }
                    }

                </div>

                <hr class="my-4" />

                <div class="d-grid">

                    <button class="btn btn-red btn-lg">
                        <i class="fa-solid fa-save me-2"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
        ```

    </div>

</body>

<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

<script src="~/js/site.js" asp-append-version="true"></script>
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const container = document.getElementById("ticketTypesContainer");
        const addBtn = document.getElementById("addTicketBtn");

        function nextIndex(){

            const inputs = container.querySelectorAll("[name^='TicketTypes[']");
            let max = -1;

            inputs.forEach(el=>{
                const match = el.name.match(/TicketTypes\[(\d+)\]/);
                if(match){
                    const i = parseInt(match[1]);
                    if(i > max) max = i;
                }
            });

            return max + 1;
        }

        function createRow(index){

            const row = document.createElement("div");

            row.className = "ticket-row card p-3 mb-2 shadow-sm border-0 rounded-4";

            row.innerHTML = `
            <div class="row g-2 align-items-center">

                <div class="col-md-5">
                    <input type="text"
                           name="TicketTypes[${index}].Name"
                           class="form-control"
                           placeholder="Ticket type"
                           required>
                </div>

                <div class="col-md-3">
                    <input type="number"
                           name="TicketTypes[${index}].Price"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Price"
                           required>
                </div>

                <div class="col-md-2">
                    <button type="button" class="btn btn-red remove-ticket">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>

            </div>`;

            return row;
        }

        addBtn.addEventListener("click", function(){

            const idx = nextIndex();
            const row = createRow(idx);
            container.appendChild(row);

        });

        container.addEventListener("click", function(e){

            if(e.target.closest(".remove-ticket")){
                const row = e.target.closest(".ticket-row");
                if(row) row.remove();
            }

        });

        const imageInput = document.getElementById("imageUrl");
        const preview = document.getElementById("imagePreview");

        function updatePreview(){

            const url = imageInput.value;

            if(url){
                preview.src = url;
                preview.style.display = "block";
            }
            else{
                preview.style.display = "none";
            }

        }

        imageInput.addEventListener("input", updatePreview);

        updatePreview();

    });

</script>
