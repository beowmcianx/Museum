@model TestProj.Models.UserModel
@using TestProj.Models

@{
    ViewData["Title"] = "My Cart";
    ViewBag.HasHeroTitle = true;
}

<!-- Popup Alert -->
@if (TempData["Success"] != null || TempData["Error"] != null)
{
    var isSuccess = TempData["Success"] != null;
    var message = isSuccess ? TempData["Success"] : TempData["Error"];

    <div id="ticketPopup" class="ticket-popup @(isSuccess ? "success" : "error")" data-aos="fade-left">
        <div class="popup-content">
            <span>@message</span>
            <button class="popup-close" onclick="closePopup()">×</button>
        </div>
    </div>
}

<div class="cart-page">
    <!-- Hero Section -->
    <div class="cart-hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-pattern"></div>

        <div class="container hero-container">
            <div class="cart-header" data-aos="fade-up">
                <div class="cart-icon-wrapper">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <h1 class="cart-title">My Cart</h1>
                <p class="cart-subtitle">View your tickets and orders</p>
            </div>
        </div>
    </div>

    <!-- Orders Section -->
    <div class="cart-content-section">
        <div class="container">
            @if (Model?.Orders == null || !Model.Orders.Any())
            {
                <div class="empty-state" data-aos="fade-up">
                    <div class="empty-state-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h3>Your cart is empty</h3>
                    <p>You have no orders yet. Start exploring museums and book your tickets!</p>
                    <a asp-controller="Museum" asp-action="Catalogue" class="btn-explore-cart">
                        <i class="fas fa-landmark"></i>
                        Browse Museums
                    </a>
                </div>
            }
            else
            {
                bool firstOrder = true;

                @foreach (var order in Model.Orders.OrderByDescending(o => o.CreatedAt))
                {
                    var items = order.OrderItems ?? new List<TestProj.Models.OrderItemModel>();
                    decimal orderTotal = items.Sum(i => i.PriceAtPurchase * i.Quantity);

                    string badgeClass = order.Status switch
                    {
                        OrderStatus.New => "status-new",
                        OrderStatus.Confirmed => "status-confirmed",
                        OrderStatus.Cancelled => "status-cancelled",
                        OrderStatus.Used => "status-used",
                        _ => "status-default"
                    };

                    <div class="order-card" data-aos="fade-up" data-aos-delay="@(firstOrder ? 100 : 200)">
                        <!-- Card Header (Collapsible) -->
                        <div class="order-card-header" data-bs-toggle="collapse" data-bs-target="#order-@order.OrderId" aria-expanded="@(firstOrder ? "true" : "false")">
                            <div class="order-header-left">
                                <i class="fas fa-ticket-alt"></i>
                                <strong>@order.OrderCode</strong>
                            </div>
                            <div class="order-header-right">
                                <span class="status-badge @badgeClass">@order.Status</span>
                                <i class="fas fa-chevron-down toggle-icon @(firstOrder ? "rotate" : "")"></i>
                            </div>
                        </div>

                        <!-- Collapsible Body -->
                        <div class="collapse @(firstOrder ? "show" : "")" id="order-@order.OrderId">
                            <div class="order-card-body">
                                <div class="order-info-row">
                                    <div class="order-museum">
                                        <i class="fas fa-landmark"></i>
                                        <span>
                                            @(order.Museum?.Name ?? "—")
                                            @if (!string.IsNullOrEmpty(order.Museum?.City))
                                            {
                                                <span class="text-muted">(@order.Museum.Country, @order.Museum.City)</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="order-dates">
                                        <div class="order-visit-date">
                                            <i class="fas fa-calendar-day"></i>
                                            <span>Visit: @order.VisitDate.ToString("yyyy-MM-dd")</span>
                                        </div>
                                        <div class="order-created-date">
                                            <i class="fas fa-clock"></i>
                                            <span>Ordered: @order.CreatedAt.ToString("yyyy-MM-dd")</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="divider-light"></div>

                                @if (!items.Any())
                                {
                                    <p class="text-muted text-center py-3">No tickets in this order.</p>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="order-table">
                                            <thead>
                                                <tr>
                                                    <th>Ticket</th>
                                                    <th>Unit Price</th>
                                                    <th>Quantity</th>
                                                    <th>Subtotal</th>
                                                    <th class="text-end">QR</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in items)
                                                {
                                                    var ticketName = item.TicketType?.Name ?? "(ticket type removed)";
                                                    <tr>
                                                        <td>@ticketName</td>
                                                        <td>@item.PriceAtPurchase.ToString("C")</td>
                                                        <td>@item.Quantity</td>
                                                        <td>@((item.PriceAtPurchase * item.Quantity).ToString("C"))</td>
                                                        <td class="text-end">
                                                            <a asp-controller="Client" asp-action="TicketDetails" asp-route-id="@item.OrderItemId">
                                                                <img src="@Url.Action("TicketQr", "Client", new { ticketId = item.OrderItemId })"
                                                                     alt="Ticket QR"
                                                                     width="120"
                                                                     height="120" />
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>

                            <div class="order-card-footer">
                                <div class="order-total">
                                    <strong>Total:</strong>
                                    <span class="total-amount">@orderTotal.ToString("C")</span>
                                </div>

                                @if (order.Status == OrderStatus.New && order.VisitDate > DateTime.Today)
                                {
                                    <form asp-controller="Client" asp-action="CancelOrder" method="post" class="cancel-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <button type="submit" class="btn-cancel-order">
                                            <i class="fas fa-times-circle"></i> Cancel Order
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>

                    firstOrder = false;
                }
            }
        </div>
    </div>

    <!-- Cancel Confirmation Modal -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content-custom">
                <div class="modal-header-custom">
                    <h5 class="modal-title" id="cancelModalLabel">
                        <i class="fas fa-exclamation-triangle" style="color: #db4a2b;"></i>
                        Cancel Order
                    </h5>
                    <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">×</button>
                </div>
                <div class="modal-body-custom">
                    <p>Are you sure you want to cancel this order?</p>
                    <ul class="cancel-warnings">
                        <li>This action cannot be undone</li>
                        <li>Refunds follow the cancellation policy</li>
                    </ul>
                </div>
                <div class="modal-footer-custom">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal">Keep Order</button>
                    <button type="button" class="btn-primary-custom btn-danger-custom" id="confirmCancelBtn">Yes, Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Decorative Circles -->
    <ul class="circles">
        <li><i class="fa-solid fa-landmark"></i></li>
        <li><i class="fa-solid fa-building-columns"></i></li>
        <li><i class="fa-solid fa-monument"></i></li>
        <li><i class="fa-solid fa-gem"></i></li>
        <li><i class="fa-solid fa-scroll"></i></li>
        <li><i class="fa-solid fa-paint-roller"></i></li>
        <li><i class="fa-solid fa-palette"></i></li>
        <li><i class="fa-solid fa-book"></i></li>
        <li><i class="fa-solid fa-masks-theater"></i></li>
    </ul>
</div>

@section Scripts {
    <script>
        function closePopup() {
            var popup = document.getElementById('ticketPopup');
            if (popup) {
                popup.classList.add('popup-hide');
                setTimeout(function() {
                    popup.style.display = 'none';
                }, 400);
            }
        }

                // Cancel order modal handling
        let formToSubmit = null;

        document.querySelectorAll('.cancel-form').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                formToSubmit = form;
                // Initialize and show the modal
                var modalElement = document.getElementById('cancelModal');
                var modal = new bootstrap.Modal(modalElement);
                modal.show();
            });
        });

        // Handle confirm button click
        var confirmBtn = document.getElementById('confirmCancelBtn');
        if (confirmBtn) {
            // Remove any existing listeners to avoid duplicates
            var newConfirmBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
            newConfirmBtn.addEventListener('click', function() {
                if (formToSubmit) {
                    formToSubmit.submit();
                }
            });
        }

        // Toggle icon rotation for collapsible headers
        document.querySelectorAll('.order-card-header').forEach(header => {
            header.addEventListener('click', function() {
                const targetId = this.getAttribute('data-bs-target');
                const collapseEl = document.querySelector(targetId);
                const icon = this.querySelector('.toggle-icon');

                setTimeout(() => {
                    if (collapseEl.classList.contains('show')) {
                        icon.classList.add('rotate');
                    } else {
                        icon.classList.remove('rotate');
                    }
                }, 10);
            });
        });
    </script>
}