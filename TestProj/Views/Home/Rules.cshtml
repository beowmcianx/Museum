@{
    ViewData["Title"] = "Ticket Purchase & Cancellation Rules";
}

<div class="container mt-5 mb-5">

    <h1 class="mb-4 text-center">Ticket Purchase & Cancellation Rules</h1>

    <div class="alert alert-info">
        Please read these rules carefully before purchasing tickets.
    </div>

    <!-- BUYING RULES -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            1. Ticket Purchase Rules
        </div>
        <div class="card-body">
            <ul>
                <li>You must be logged in to purchase tickets.</li>
                <li>The visit date must not be in the past.</li>
                <li>At least one ticket must be selected.</li>
                <li>Only active ticket types may be purchased.</li>
                <li>All ticket purchases are subject to museum availability.</li>
                <li>Once an order is completed, the price at purchase time is final.</li>
            </ul>
        </div>
    </div>

    <!-- CANCELLATION RULES -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-danger text-white">
            2. Cancellation Rules
        </div>
        <div class="card-body">
            <ul>
                <li>Only orders with status <strong>New</strong> can be cancelled.</li>
                <li>Orders cannot be cancelled on or after the visit date.</li>
                <li>Cancelled orders cannot be restored.</li>
                <li>Used or Confirmed tickets cannot be cancelled.</li>
                <li>The system reserves the right to refuse cancellation if policy conditions are not met.</li>
            </ul>
        </div>
    </div>

    <!-- ORDER STATUS EXPLANATION -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-secondary text-white">
            3. Order Status Explanation
        </div>
        <div class="card-body">
            <ul>
                <li><strong>New</strong> – The order has been created but not yet processed.</li>
                <li><strong>Confirmed</strong> – The order has been approved and is valid for entry.</li>
                <li><strong>Cancelled</strong> – The order has been cancelled and is no longer valid.</li>
                <li><strong>Used</strong> – The tickets have already been scanned and used for entry.</li>
            </ul>
        </div>
    </div>

    <!-- REFUND POLICY -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-warning">
            4. Refund Policy
        </div>
        <div class="card-body">
            <ul>
                <li>Full refunds may be issued if cancellation occurs more than 48 hours before the visit date.</li>
                <li>Partial refunds may apply between 24–48 hours before the visit date.</li>
                <li>No refunds are issued within 24 hours of the visit date.</li>
                <li>Refund policies may vary depending on special events or promotions.</li>
            </ul>
        </div>
    </div>

    <!-- GENERAL CONDITIONS -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">
            5. General Conditions
        </div>
        <div class="card-body">
            <ul>
                <li>Tickets are non-transferable.</li>
                <li>The museum reserves the right to deny entry in case of misuse.</li>
                <li>Visitors must present valid proof of purchase upon entry.</li>
                <li>The system may update these rules without prior notice.</li>
            </ul>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-action="Catalogue" asp-controller="Home" class="btn btn-red">
            Back to Catalogue
        </a>
    </div>

</div>