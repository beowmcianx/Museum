@{
    ViewData["Title"] = "Ticket Purchase & Cancellation Rules";
}

<div class="container page-policy py-5">

    <div class="text-center mb-5">
        <h1 class="display-5">
            <i class="fa-solid fa-book me-2" style="color:#db4a2a"></i>
            <span class="display-4 text-red">@ViewData["Title"]</span>
        </h1>
        <p class="lead text-muted">Please read the following rules carefully before purchasing or cancelling tickets.</p>
        <hr class="hr-light" />
    </div>

    <!-- Ticket Purchase Rules -->
    <div class="card shadow-lg rounded-4 mb-4">
        <div class="card-header text-white bg-red">
            <i class="fa-solid fa-ticket me-2"></i> 1. Ticket Purchase Rules
        </div>
        <div class="card-body">
            <ul>
                <li>You must be logged in to purchase tickets.</li>
                <li>The visit date cannot be in the past.</li>
                <li>At least one ticket must be selected per order.</li>
                <li>Only active ticket types may be purchased.</li>
                <li>All ticket purchases are subject to museum availability.</li>
                <li>Once an order is completed, the price at purchase time is final.</li>
            </ul>
        </div>
    </div>

    <!-- Cancellation Rules -->
    <div class="card shadow-lg rounded-4 mb-4">
        <div class="card-header text-white bg-danger">
            <i class="fa-solid fa-ban me-2"></i> 2. Cancellation Rules
        </div>
        <div class="card-body">
            <ul>
                <li>Only orders with status <strong>New</strong> can be cancelled.</li>
                <li>Orders cannot be cancelled on or after the visit date.</li>
                <li>Cancelled orders cannot be restored.</li>
                <li>Used or Confirmed tickets cannot be cancelled.</li>
                <li>The system may refuse cancellation if policy conditions are not met.</li>
            </ul>
        </div>
    </div>

    <!-- Order Status Explanation -->
    <div class="card shadow-lg rounded-4 mb-4">
        <div class="card-header text-white bg-secondary">
            <i class="fa-solid fa-info-circle me-2"></i> 3. Order Status Explanation
        </div>
        <div class="card-body">
            <ul>
                <li><strong>New</strong> – Order created but not yet processed.</li>
                <li><strong>Confirmed</strong> – Order approved and valid for entry.</li>
                <li><strong>Cancelled</strong> – Order cancelled and no longer valid.</li>
                <li><strong>Used</strong> – Tickets scanned and used for entry.</li>
            </ul>
        </div>
    </div>

    <!-- Refund Policy -->
    <div class="card shadow-lg rounded-4 mb-4">
        <div class="card-header text-white bg-warning">
            <i class="fa-solid fa-money-bill-wave me-2"></i> 4. Refund Policy
        </div>
        <div class="card-body">
            <ul>
                <li>Full refunds may be issued if cancellation occurs more than 48 hours before the visit date.</li>
                <li>Partial refunds may apply 24–48 hours before the visit date.</li>
                <li>No refunds are issued within 24 hours of the visit date.</li>
                <li>Refunds may vary for special events or promotions.</li>
            </ul>
        </div>
    </div>

    <!-- General Conditions -->
    <div class="card shadow-lg rounded-4 mb-4">
        <div class="card-header text-white bg-dark">
            <i class="fa-solid fa-gavel me-2"></i> 5. General Conditions
        </div>
        <div class="card-body">
            <ul>
                <li>Tickets are non-transferable.</li>
                <li>The museum reserves the right to deny entry in case of misuse.</li>
                <li>Visitors must present valid proof of purchase upon entry.</li>
                <li>The system may update these rules without prior notice.</li>
            </ul>
        </div>
    </div>

    <div class="text-center mt-4">
        <a asp-controller="Museum" asp-action="Catalogue" class="btn btn-red px-4 py-2">
            Browse Museums
        </a>
    </div>

</div>

<!-- Floating background icons -->
<ul class='circles'>
    <li><i class="fa-solid fa-landmark fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-building-columns fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-monument fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-gem fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-scroll fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-paint-roller fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-palette fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-book fa-lg" style="color: #f2b5a7;"></i></li>
    <li><i class="fa-solid fa-masks-theater fa-lg" style="color: #f2b5a7;"></i></li>
</ul>

<script src="~/js/site.js" asp-append-version="true"></script>