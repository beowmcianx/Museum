@model List<TestProj.Models.MuseumModel>

@{
    ViewData["Title"] = "Catalogue Page";
}

<body class="page-catalogue">
    <div class="text-center">

        <h1 class="display-4">Discover The Right Museum</h1>
        <h4 class="text-lowercase text-secondary">filter based on your interests</h4>
        <br />

        @*Search Card*@
        <div class="card mx-auto shadow-sm p-4 mb-5 rounded-5 page-catalogue-search-bar">
            <form asp-action="Catalogue" method="get" class="row g-2 align-items-center">

                <!-- Search -->
                <div class="col-md-4">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-search"></i>
                        </span>
                        <input class="form-control"
                               type="search"
                               name="searchString"
                               value="@ViewBag.SearchString"
                               placeholder="Search anything..." />
                    </div>
                </div>

                <!-- Country Filter -->
                <div class="col-md-2">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-flag"></i>
                        </span>
                        <select class="form-select" name="countryFilter">
                            <option value="">All Countries</option>
                            @foreach (var country in ViewBag.Countries)
                            {
                                <option value="@country" selected="@(country == ViewBag.CountryFilter)">
                                    @country
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- City Filter -->
                <div class="col-md-2">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-city"></i>
                        </span>
                        <select class="form-select" name="cityFilter">
                            <option value="">All Cities</option>
                            @foreach (var city in ViewBag.Cities)
                            {
                                <option value="@city" selected="@(city == ViewBag.CityFilter)">
                                    @city
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Type Filter -->
                <div class="col-md-2">
                    <div class="input-group h-100">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-landmark"></i>
                        </span>
                        <select class="form-select" name="typeFilter">
                            <option value="">All Types</option>
                            @foreach (var type in ViewBag.Types)
                            {
                                <option value="@type" selected="@(type == ViewBag.TypeFilter)">
                                    @type
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Filter Button -->
                <div class="col-md-2">
                    <button class="btn btn-red w-100 d-flex align-items-center justify-content-center" type="submit">
                        <i class="fas fa-filter me-2"></i> Filter
                    </button>
                </div>

            </form>
            </form>
        </div>

        @*Museum Card*@
        <div class="card mx-auto shadow-sm p-3 mb-5 rounded-5 page-catalogue-card">
            <div class="card-body">
                <div class="row">
                    @foreach (var museum in Model)
                    {
                        var firstImageUrl = museum.Images?.FirstOrDefault()?.ImageUrl;
                        <div class="col-sm-12 col-md-6 col-lg-6 mb-5">
                            <div class="card h-100 shadow-lg border-0 rounded-4 museum-card">

                                <!-- Card Header -->
                                <div class="card-header bg-dark text-white rounded-top-4 py-3">
                                    <h5 class="mb-0">
                                        <i class="fa-solid fa-landmark fa-lg"
                                           style="color:#db4a2a; margin-right:15px;"></i>
                                        @museum.Name
                                    </h5>
                                </div>

                                <!-- Card Body -->
                                <div class="card-body p-4">

                                    <!-- Museum Image -->
                                    <img src="@(firstImageUrl ?? "/images/Image-not-found.png")"
                                         alt="@museum.Name"
                                         class="img-fluid rounded-3 mb-4 w-100"
                                         style="height: 220px; object-fit: cover;" />

                                    <h6 class="text-muted text-uppercase fw-bold mb-3">
                                        Location
                                    </h6>

                                    <p class="mb-2 fs-6">
                                        <i class="fa-solid fa-location-dot me-2 text-danger"></i>
                                        @museum.Country, @museum.City, @museum.Address
                                    </p>

                                    <p class="mb-4 fs-6">
                                        <i class="fa-solid fa-clock me-2 text-danger"></i>
                                        @(DateTime.Today.Add(museum.OpeningTime).ToString("h:mm tt").ToLowerInvariant())
                                        -
                                        @(DateTime.Today.Add(museum.ClosingTime).ToString("h:mm tt").ToLowerInvariant())
                                    </p>
                                    <hr class="hr-dark" />

                                    <div class="d-grid">
                                        <a class="btn btn-red btn-lg"
                                           asp-controller="Home"
                                           asp-action="Details"
                                           asp-route-id="@museum.MuseumId">
                                            View Details
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>

                <hr />

                @*Pagination*@
                <h5>Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages pages</h5>

                <nav>
                    <ul class="pagination justify-content-center">

                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Catalogue"
                                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-countryFilter="@ViewBag.CountryFilter"
                                   asp-route-cityFilter="@ViewBag.CityFilter"
                                   asp-route-typeFilter="@ViewBag.TypeFilter">
                                    Previous
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Catalogue"
                                   asp-route-page="@i"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-countryFilter="@ViewBag.CountryFilter"
                                   asp-route-cityFilter="@ViewBag.CityFilter"
                                   asp-route-typeFilter="@ViewBag.TypeFilter">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-action="Catalogue"
                                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                                   asp-route-searchString="@ViewBag.SearchString"
                                   asp-route-countryFilter="@ViewBag.CountryFilter"
                                   asp-route-cityFilter="@ViewBag.CityFilter"
                                   asp-route-typeFilter="@ViewBag.TypeFilter">
                                    Next
                                </a>
                            </li>
                        }


                    </ul>
                </nav>

            </div>
        </div>

    </div>
</body>