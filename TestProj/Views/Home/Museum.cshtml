@model TestProj.Models.MuseumModel

@{
    ViewData["Title"] = $"{Model.Name}";
}

<div class="position-relative" style="margin: 0;">
    <div class="text-center">
        <h1 class="display-4">@ViewData["Title"]</h1>
        <h4 class="text-secondary text-muted">view & edit your museums information</h4>
    </div>

    <br />
    <hr />
    <br />

    <div class="d-flex justify-content-between gap-2">
        <a class="btn btn-red flex-fill text-center" 
           asp-area=""
           asp-controller="Home"
           asp-action="EditMuseum"
           asp-route-id="@Model.MuseumId">
            <i class="fas fa-landmark"></i><br />
            Museum Info
        </a>

        <a class="btn btn-red flex-fill text-center"
           asp-area=""
           asp-controller="Home"
           asp-action="EditMuseum"
           asp-route-id="@Model.MuseumId">
            <i class="fas fa-ticket"></i><br />
            Order Info
        </a>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            var container = document.getElementById('ticketTypesContainer');
            var addBtn = document.getElementById('addTicketBtn');

            function nextIndex() {
                var existing = container.querySelectorAll('[name^="TicketTypes["]');
                if (!existing.length) return 0;
                var max = -1;
                existing.forEach(function (el) {
                    var name = el.name;
                    var m = name.match(/^TicketTypes\[(\d+)\]/);
                    if (m) {
                        var i = parseInt(m[1], 10);
                        if (i > max) max = i;
                    }
                });
                return max + 1;
            }

            function createRow(index) {
            var row = document.createElement('div');
            row.className = 'ticket-row d-flex gap-2 mb-2 align-items-center';

            var nameInput = document.createElement('input');
            nameInput.type = 'text';
            nameInput.name = 'TicketTypes[' + index + '].Name';
            nameInput.className = 'form-control';
            nameInput.placeholder = 'Type (Adult, Child...)';
            nameInput.style.maxWidth = '250px';

            var priceInput = document.createElement('input');
            priceInput.type = 'number';
            priceInput.step = '0.01';
            priceInput.min = '0';
            priceInput.name = 'TicketTypes[' + index + '].Price';
            priceInput.className = 'form-control';
            priceInput.placeholder = 'Price';
            priceInput.style.maxWidth = '140px';

            var removeBtn = document.createElement('button');
            removeBtn.type = 'button';
            removeBtn.className = 'btn btn-danger btn-sm remove-ticket';
            removeBtn.style.marginLeft = '6px';
            removeBtn.textContent = 'Remove';
            removeBtn.addEventListener('click', function () {
                row.remove();
            });

            row.appendChild(nameInput);
            row.appendChild(priceInput);
            row.appendChild(removeBtn);

            return row;
        }

            addBtn.addEventListener('click', function () {
                var idx = nextIndex();
                var r = createRow(idx);
                container.appendChild(r);
            });

            container.addEventListener('click', function (e) {
                if (e.target && e.target.matches('.remove-ticket')) {
                    var row = e.target.closest('.ticket-row');
                    if (row) row.remove();
                }
            });
        })();
    </script>
}