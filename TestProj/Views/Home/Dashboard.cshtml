@model List<TestProj.Models.MuseumModel>

@{
    ViewData["Title"] = "Dashboard";
}


<div class="text-center">
    <h1 class="display-4">Dashboard</h1>
    <h4 class="text-secondary text-muted">view, create, and edit museums and accounts</h4>

    <br />
    <hr />

    <div class="align-content-between">

        <a class="btn btn-success page-dashboard-button"
           asp-controller="Home"    
           asp-action="Create">
            Create Museum
        </a>

        <a class="btn btn-warning page-dashboard-button"
           asp-controller="Home"
           asp-action="Create">
            Accounts
        </a>
    </div>

    <hr />  
    <br />

    <h3 class="text-center">Museums</h3>
    <br />

    @* Search Card *@
        <form asp-action="Dashboard" method="get" class="row g-2">

            <div class="col-md-4">
                <input class="form-control"
                       type="search"
                       name="searchString"
                       value="@ViewBag.SearchString"
                       placeholder="Search anything..." />
            </div>

            <div class="col-md-3">
                <select class="form-select" name="cityFilter">
                    <option value="">All Cities</option>
                    @foreach (var city in ViewBag.Cities)
                    {
                        <option value="@city"
                                selected="@(city == ViewBag.CityFilter)">
                            @city
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <select class="form-select" name="typeFilter">
                    <option value="">All Types</option>
                    @foreach (var type in ViewBag.Types)
                    {
                        <option value="@type"
                                selected="@(type == ViewBag.TypeFilter)">
                            @type
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-red w-100" type="submit">
                    Filter
                </button>
            </div>

        </form>

    <br />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>City/Address</th>
                <th>Type</th>
                <th>Working Hours</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var museum in Model)
            {
                <tr>
                    <td>@museum.MuseumId</td>
                    <td>@museum.Name</td>
                    <td>@museum.City, @museum.Address</td>
                    <td>@museum.Type</td>
                    <td>
                        @(DateTime.Today.Add(museum.OpeningTime).ToString("h:mm tt").ToLowerInvariant())
                        -
                        @(DateTime.Today.Add(museum.ClosingTime).ToString("h:mm tt").ToLowerInvariant())
                    </td>
                    <td>@museum.IsActive</td>

                    <td>
                        <a class="btn btn-info"
                           asp-controller="Home"
                           asp-action="Edit"
                           asp-route-id="@museum.MuseumId">
                            Edit
                        </a>

                        <form asp-controller="Home"
                              asp-action="Delete"
                              asp-route-id="@museum.MuseumId"
                              method="post"
                              style="display:inline;">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this museum?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h5>Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages pages</h5>

    <nav>
        <ul class="pagination justify-content-center">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Dashboard"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-cityFilter="@ViewBag.CityFilter"
                       asp-route-typeFilter="@ViewBag.TypeFilter">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Dashboard"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-cityFilter="@ViewBag.CityFilter"
                       asp-route-typeFilter="@ViewBag.TypeFilter">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Dashboard"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-cityFilter="@ViewBag.CityFilter"
                       asp-route-typeFilter="@ViewBag.TypeFilter">
                        Next
                    </a>
                </li>
            }

        </ul>
    </nav>

</div>