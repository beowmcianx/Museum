@model TestProj.Models.MuseumModel

@{
    ViewData["Title"] = "Dashboard";
}


<div class="text-center">
    <h1 class="display-4">Dashboard</h1>
    <h4 class="text-secondary text-muted">view, create, and edit museums and accounts</h4>

    <br />
    <hr />

    <div class="align-content-between">

        <a class="btn btn-success page-dashboard-button"
           asp-controller="Home"    
           asp-action="Create">
            Create Museum
        </a>

        <a class="btn btn-warning page-dashboard-button"
           asp-controller="Home"
           asp-action="Create">
            Accounts
        </a>
    </div>

    <hr />  
    <br />

    <h3 class="text-center">Museums</h3>
    <br />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>City/Address</th>
                <th>Type</th>
                <th>Working Hours</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var museum in ViewBag.Museums as List<TestProj.Models.MuseumModel>)
            {
                <tr>
                    <td>@museum.MuseumId</td>
                    <td>@museum.Name</td>
                    <td>@museum.City, @museum.Address</td>
                    <td>@museum.Type</td>
                    <td>@museum.OpeningTime - @museum.ClosingTime</td>
                    <td>@museum.IsActive</td>

                    <td>
                        <a class="btn btn-info"
                           asp-controller="Home"
                           asp-action="Edit"
                           asp-route-id="@museum.MuseumId">
                            Edit
                        </a>

                        <form asp-controller="Home"
                              asp-action="Delete"
                              asp-route-id="@museum.MuseumId"
                              method="post"
                              style="display:inline;">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this museum?');">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>