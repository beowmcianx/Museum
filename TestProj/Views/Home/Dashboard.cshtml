    <br />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Country/City/Address</th>
                <th>Type</th>
                <th>Working Hours</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var museum in Model)
            {
                <tr>
                    <td>@museum.MuseumId</td>
                    <td>@museum.Name</td>
                    <td>@museum.Country, @museum.City, @museum.Address</td>
                    <td>@museum.Type</td>
                    <td>
                        @(DateTime.Today.Add(museum.OpeningTime).ToString("h:mm tt").ToLowerInvariant())
                        -
                        @(DateTime.Today.Add(museum.ClosingTime).ToString("h:mm tt").ToLowerInvariant())
                    </td>
                    <td>@museum.IsActive</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a class="btn btn-info"
                               asp-controller="Home"
                               asp-action="Edit"
                               asp-route-id="@museum.MuseumId">
                                Edit
                            </a>

                            <form asp-controller="Home"
                                  asp-action="Delete"
                                  asp-route-id="@museum.MuseumId"
                                  method="post"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this museum?');">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <h5>Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages pages</h5>

    <nav>
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Dashboard"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-cityFilter="@ViewBag.CityFilter"
                       asp-route-typeFilter="@ViewBag.TypeFilter">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Dashboard"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-cityFilter="@ViewBag.CityFilter"
                       asp-route-typeFilter="@ViewBag.TypeFilter">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="Dashboard"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-cityFilter="@ViewBag.CityFilter"
                       asp-route-typeFilter="@ViewBag.TypeFilter">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>
</div>