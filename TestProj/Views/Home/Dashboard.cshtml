@model TestProj.Models.MuseumModel

@{
    ViewData["Title"] = "Dashboard";
}


<div class="text-center">
    <h1 class="display-4">The Museum Central</h1>
    <br />

    <hr />
    <h2>Museums</h2>
    <br />

    <a class="btn btn-success"
       asp-controller="Home"
       asp-action="Create">
        Create Museum
    </a>

    <hr />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>City/Address</th>
                <th>Type</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var museum in ViewBag.Museums as List<TestProj.Models.MuseumModel>)
            {
                <tr>
                    <td>@museum.MuseumId</td>
                    <td>@museum.Name</td>
                    <td>@museum.City, @museum.Address</td>
                    <td>@museum.Type</td>
                    <td>@museum.IsActive</td>

                    <td>
                        <form asp-controller="Home"
                              asp-action="Delete"
                              asp-route-id="@museum.MuseumId"
                              method="post"
                              style="display:inline;">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this museum?');">
                                Delete
                            </button>
                        </form>

                        <a class="btn btn-info"
                           asp-controller="Home"
                           asp-action="Edit"
                           asp-route-id="@museum.MuseumId">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>