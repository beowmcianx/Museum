@model TestProj.Models.MuseumModel

@{
    ViewData["Title"] = $"{Model.Name}";
}   

<div class="position-relative" style="margin: 0;">

    <form asp-controller="Home"
          asp-action="Museum"
          asp-route-id="@Model.MuseumId"
          method="post"
          class="text-end mb-3 container-back">
        <button type="submit" class="btn btn-back">
            Back
        </button>
    </form>

    <div class="text-center">
        <h1>@ViewData["Title"] Information</h1>
        <h4 class="text-secondary text-muted">edit your museums info</h4>
    </div>

    <div asp-validation-summary="All"></div>
    <form asp-action="EditMuseum" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MuseumId" />

        <div>
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div>
            <label asp-for="Country"></label>
            <input asp-for="Country" class="form-control" required />
        </div>

        <div>
            <label asp-for="City"></label>
            <input asp-for="City" class="form-control" required />
        </div>

        <div>
            <label asp-for="Address"></label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div>
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="d-flex gap-3 align-items-end">

            <div>
                <label asp-for="OpeningTime" class="form-label"></label>
                <input asp-for="OpeningTime" class="form-control" step="60" type="time" />
            </div>

            <div>
                <label asp-for="ClosingTime" class="form-label"></label>
                <input asp-for="ClosingTime" class="form-control" step="60" type="time" />
            </div>

        </div>

        <div>
            <label asp-for="Type"></label>
            <input asp-for="Type" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="imageUrl" class="form-label">Museum image URL</label>
            <input type="url" name="ImageUrl" id="imageUrl" class="form-control" placeholder="https://example.com/path/to/image.jpg" />
            <div class="form-text">Optional. Paste a public image URL (JPG/PNG/GIF). Our site stores and displays the URL.</div>
            <span asp-validation-for="Images" class="text-danger"></span>
        </div>


        <hr class="hr-dark" />

        <h4>Ticket types</h4>
        <p class="text-muted">Add ticket types. Leave rows empty to ignore.</p>

        <div class="mb-3">
            <button type="button" id="addTicketBtn" class="btn btn-success btn-sm">Add Row</button>
        </div>

        <div id="ticketTypesContainer">
            <!-- existing server-side entries (if any) will be rendered here by server-side when editing; for Create, no initial types -->
            <div class="ticket-row d-flex gap-2 mb-2 align-items-center">
                <input type="text" name="TicketTypes[0].Name" class="form-control" placeholder="Type (Adult, Child...)" style="max-width:250px;" required />
                <input type="number" name="TicketTypes[0].Price" class="form-control" placeholder="Price" step="0.1" min="0" style="max-width:140px;" required />
                <button type="button" class="btn btn-danger btn-sm remove-ticket" style="margin-left:6px;">Remove</button>
            </div>
        </div>

        <hr class="hr-dark" />
        <br />

        <button type="submit" class="btn btn-red">Save Changes</button>
    </form>
</div>
